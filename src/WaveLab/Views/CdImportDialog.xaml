<Window x:Class="WaveLab.Views.CdImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract Audio CD" Width="620" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">
    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,16"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Extract Audio CD" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="44.1 kHz · stereo · lossless" Margin="14,2,0,0" FontSize="10.5"
                               Foreground="{StaticResource Faint}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OPTICAL DRIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <ComboBox x:Name="driveCombo" Margin="0,6,0,0" SelectionChanged="OnDriveChanged"
                              DisplayMemberPath="DisplayText" AutomationProperties.Name="Optical drive"/>
                </StackPanel>
                <Button Grid.Column="2" Height="36" VerticalAlignment="Bottom" Content="Refresh"
                        Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnRefresh"/>
            </Grid>

            <Border Grid.Row="2" Margin="20,0,20,12" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="14,10" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="USE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <TextBlock Grid.Column="1" Text="TRACK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <TextBlock Grid.Column="2" Text="START" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <TextBlock Grid.Column="3" Text="DURATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}" TextAlignment="Right"/>
                    </Grid>
                    <ListBox x:Name="trackList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Padding="14,8" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Panel3}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StartText}" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="20,0,20,14">
                <Grid>
                    <CheckBox x:Name="selectAll" Content="Select all audio tracks" IsChecked="True" Click="OnSelectAll"/>
                    <TextBlock x:Name="summaryText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                </Grid>
                <ProgressBar x:Name="progressBar" Height="6" Minimum="0" Maximum="1" Margin="0,12,0,0"
                             Foreground="{StaticResource Accent}" Background="{StaticResource Panel3}" Value="0"/>
                <TextBlock x:Name="statusText" Text="Scanning optical drives…" Margin="0,8,0,0"
                           FontSize="11" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Row="4" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="cancelBtn" Content="Cancel" Height="38" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}" Click="OnCancel"/>
                    <Button x:Name="importBtn" Grid.Column="2" Content="Extract Selected" Height="38"
                            Style="{StaticResource AccentButton}" IsEnabled="False" Click="OnImport"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
