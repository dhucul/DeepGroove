<Window x:Class="WaveLab.Views.AdjustGainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust Gain" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">
    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <StackPanel>
            <TextBlock Text="Adjust Gain" FontSize="16" FontWeight="SemiBold" MouseLeftButtonDown="OnDragMove"/>
            <TextBlock x:Name="rangeText" Margin="0,8,0,14" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock Text="GAIN CHANGE (dB)" FontSize="10" FontWeight="Bold"/>
            <TextBox x:Name="gainText" Text="0.0" Margin="0,7,0,7" Padding="8"
                     AutomationProperties.Name="Gain change in decibels"
                     TextChanged="OnGainChanged"/>
            <TextBlock Text="−60 to +60 dB, in 0.1 dB steps. Positive is louder; negative is quieter."
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="This changes the recorded audio, not the original hardware input gain. Existing clipping cannot be repaired by gain adjustment."
                       Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="validationText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Amber}"/>
            <TextBlock x:Name="clippingText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Amber}"
                       Text="Positive gain can push peaks above 0 dBFS. No limiter or normalization is applied; PCM export can clip."
                       Visibility="Collapsed"/>
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="Cancel" Height="35" Style="{StaticResource AccentButton}" IsCancel="True"/>
                <Button x:Name="applyBtn" Grid.Column="2" Content="Apply Gain" Height="35"
                        Style="{StaticResource AccentButton}" IsDefault="True" IsEnabled="False" Click="OnApply"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
