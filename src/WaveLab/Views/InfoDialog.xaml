<Window x:Class="WaveLab.Views.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Groove" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="22,20">
            <TextBlock x:Name="titleText" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="bigText" FontFamily="{StaticResource MonoFont}" FontSize="26"
                       Foreground="{StaticResource Accent}" Margin="0,12,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="messageText" Margin="0,10,0,0" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
            <Button Style="{StaticResource AccentButton}" Height="34" Margin="0,16,0,0" Click="OnOk" Content="OK"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
