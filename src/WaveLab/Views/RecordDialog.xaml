<Window x:Class="WaveLab.Views.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaveLab.Views.Controls"
        Title="Record Audio" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,16"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                    <TextBlock Text="Record Audio" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
            <StackPanel Margin="20,17,20,16">
                <TextBlock Text="INPUT DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                <ComboBox x:Name="deviceCombo" Margin="0,6,0,0" ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="Input device">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="FORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"
                           Margin="0,13,0,0"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="12,9" Margin="0,6,0,0">
                    <TextBlock Text="{Binding FormatText}" Foreground="#CDD3D9" FontSize="12"/>
                </Border>

                <Grid Margin="0,14,0,0">
                    <TextBlock Text="INPUT LEVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBlock Text="Peak · RMS · held peak" HorizontalAlignment="Right" FontSize="10"
                               Foreground="{StaticResource Faint}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="L" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center"/>
                    <c:LevelMeter Grid.Column="1" Height="16" Orientation="Horizontal" ShowTargetRange="True"
                                  PeakDb="{Binding PeakLDb}" RmsDb="{Binding RmsLDb}" PeakHoldDb="{Binding HoldLDb}"
                                  TargetMinimumDb="{Binding TargetMeterMinimumDb}"
                                  TargetMaximumDb="{Binding TargetMeterMaximumDb}"/>
                    <TextBlock Grid.Row="2" Text="R" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <c:LevelMeter Grid.Row="2" Grid.Column="1" Height="16" Orientation="Horizontal" ShowTargetRange="True"
                                  PeakDb="{Binding PeakRDb}" RmsDb="{Binding RmsRDb}" PeakHoldDb="{Binding HoldRDb}"
                                  TargetMinimumDb="{Binding TargetMeterMinimumDb}"
                                  TargetMaximumDb="{Binding TargetMeterMaximumDb}"/>
                </Grid>
                <Grid Margin="18,4,0,0" TextElement.FontFamily="{StaticResource MonoFont}"
                      TextElement.FontSize="9" TextElement.Foreground="{StaticResource Faint}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="6*"/><ColumnDefinition Width="6*"/><ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="−60"/>
                    <TextBlock Grid.Column="1" Text="−36" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="−24" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="−18" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="−12" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="5" Text="−6" Margin="-6,0,0,0"/>
                    <TextBlock Grid.Column="5" Text="0" HorizontalAlignment="Right"/>
                </Grid>

                <Border Background="#111C1B" BorderBrush="#2D514B" BorderThickness="1" CornerRadius="10"
                        Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LevelTargetText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="#7FA69F" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Recording Level Assistant" Margin="8,0,0,0" FontWeight="SemiBold"
                                           Foreground="#D7F8F2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding LevelStatusTitle}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#DDF5EF"/>
                                <TextBlock Text="{Binding LevelStatusDetail}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="#95A7A3" FontSize="11.5" LineHeight="17"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#172724" BorderBrush="#37675E" BorderThickness="1"
                                    CornerRadius="8" Padding="11,8" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="SUGGESTED INPUT CHANGE" FontSize="8.5" FontWeight="Bold"
                                               Foreground="#77958E" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SuggestedGainText}" Margin="0,4,0,0"
                                               FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="Bold"
                                               Foreground="#CFFFF4" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8">
                                <StackPanel><TextBlock Text="TRUE PEAK" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding TruePeakText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="PROJECTED" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding ProjectedPeakText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="PROGRAM RMS" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding ProgramRmsText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="CREST" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding CrestFactorText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="L / R" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding BalanceText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="5" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="CLIPPING" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding ClippingText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClippingText}" Value="NONE">
                                                        <Setter Property="Foreground" Value="#73E6AE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock></StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ProgressBar Height="5" Minimum="0" Maximum="100"
                                             Value="{Binding LevelConfidencePercent, Mode=OneWay}"
                                             Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="{Binding LevelProgressText}" Margin="0,5,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="#7F918C"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="levelCheckBtn" Content="{Binding LevelCheckButtonText}"
                                    Width="112" Height="32" Margin="14,0,0,0" Style="{StaticResource AccentButton}"
                                    Click="OnLevelCheck" ToolTip="Monitor without keeping the calibration audio"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="METRONOME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"
                           Margin="0,14,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chkCountIn" Content="Count-in" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBpm" Grid.Column="2" Text="120" Padding="8,5" FontSize="12" VerticalAlignment="Center"
                             AutomationProperties.Name="Metronome tempo in BPM"/>
                    <TextBlock Grid.Column="4" Text="BPM ·" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ComboBox x:Name="cmbBars" Width="86" Height="30" AutomationProperties.Name="Count-in bars"/>
                        <CheckBox x:Name="chkMetronome" Content="Click while recording" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkPunch" Content="Insert into selection on stop (punch)" Margin="0,12,0,0"
                          Visibility="Collapsed"/>
                <TextBlock x:Name="countInText" Text="COUNT-IN…" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Amber}" HorizontalAlignment="Center" Margin="0,9,0,0"
                           Visibility="Collapsed"/>
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource MonoFont}" FontSize="28"
                           Foreground="{StaticResource Red}" HorizontalAlignment="Center" Margin="0,8,0,2"/>
            </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="cancelBtn" Content="Cancel" Height="38" Click="OnCancel"
                            Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"/>
                    <Button Grid.Column="2" x:Name="startBtn" Height="38" Click="OnStartStop"
                            Style="{StaticResource DangerButton}" AutomationProperties.Name="Start or stop recording">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="startText" Text="Start Recording" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
