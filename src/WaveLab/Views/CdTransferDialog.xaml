<Window x:Class="WaveLab.Views.CdTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepare Audio CD" Width="1100" Height="716" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">
    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Amber}" VerticalAlignment="Center"/>
                    <TextBlock Text="Prepare Audio CD" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="regions → ordered tracks → 44.1 kHz / 16-bit WAV + CUE, or a DDP image set"
                               Margin="14,2,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20,15,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="260"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DISC TITLE" Style="{StaticResource UpperLabel}"/>
                    <TextBox x:Name="discTitle" Margin="0,6,0,0" Padding="10,7" TextChanged="OnPlanChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DISC PERFORMER" Style="{StaticResource UpperLabel}"/>
                    <TextBox x:Name="discPerformer" Margin="0,6,0,0" Padding="10,7"
                             ToolTip="CD-TEXT performer for the disc. DDP only."/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="UPC / EAN" Style="{StaticResource UpperLabel}"/>
                    <TextBox x:Name="discUpc" Margin="0,6,0,0" Padding="10,7" FontFamily="{StaticResource MonoFont}"
                             TextChanged="OnPlanChanged"
                             ToolTip="Thirteen digits, or twelve which are padded. Blank if the disc has none."/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0,20,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DELIVERABLE" Style="{StaticResource UpperLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton x:Name="wavCueBtn" Style="{StaticResource SegmentButton}" Height="30"
                                      Content="WAV + CUE" IsChecked="True" Click="OnDeliverableChanged"
                                      ToolTip="A burner-ready package: sector-aligned 16-bit WAVs and a cue sheet."/>
                        <ToggleButton x:Name="ddpBtn" Style="{StaticResource SegmentButton}" Height="30" Margin="6,0,0,0"
                                      Content="DDP 2.00 image set" Click="OnDeliverableChanged"
                                      ToolTip="What a pressing plant takes: PQ sheet, CD-TEXT, catalogue numbers and a checksum."/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="deliverableHint" Grid.Column="1" Margin="16,20,16,0" FontSize="10.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Faint}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="importIsrcBtn" Content="Import ISRCs…" Width="112" Height="30"
                            Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Click="OnImportIsrcs" ToolTip="A plain text file, one ISRC per line, in track order."/>
                    <Button x:Name="autoNumberBtn" Content="Auto-number" Width="102" Height="30" Margin="6,0,0,0"
                            Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Click="OnAutoNumberIsrcs"
                            ToolTip="Fill every ISRC from the first one, advancing the designation code."/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Margin="20,0,20,10" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AUTO SPLIT" VerticalAlignment="Center" Style="{StaticResource UpperLabel}"/>
                    <TextBlock Grid.Column="1" Text="Quiet below" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="thresholdSlider" Width="150" Minimum="-70" Maximum="-25" Value="-45" ValueChanged="OnThresholdChanged"/>
                        <TextBlock x:Name="thresholdText" Width="52" Margin="8,0,0,0" Text="−45 dB" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="analyzeBtn" Grid.Column="3" Content="Analyze" Height="32" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}" Click="OnAutoSplit"/>
                </Grid>
            </Border>

            <Border Grid.Row="4" Margin="20,0,20,10" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="14,10" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/><ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="128"/><ColumnDefinition Width="42"/>
                            <!-- A source position prints as hh:mm:ss.mmm; 92 px cut it to "00:03:20.". -->
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TRK" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="1" Text="TITLE" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="2" Text="PERFORMER" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="3" Text="SONGWRITER" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="4" Text="ISRC" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="5" Text="EMPH" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="6" Text="SOURCE IN" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="7" Text="SOURCE OUT" Style="{StaticResource UpperLabel}"/>
                        <TextBlock Grid.Column="8" Text="CD LENGTH" Style="{StaticResource UpperLabel}"/>
                    </Grid>
                    <ListBox x:Name="trackList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnTrackSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="row" Padding="14,7" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Panel3}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#21312F"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/><ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="128"/><ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OrderText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="2" Text="{Binding Performer, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,4" Margin="0,0,6,0" IsEnabled="{Binding DdpFields}"
                                     ToolTip="CD-TEXT performer for this track. DDP only."/>
                            <TextBox Grid.Column="3" Text="{Binding Songwriter, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,4" Margin="0,0,6,0" IsEnabled="{Binding DdpFields}"
                                     ToolTip="CD-TEXT songwriter for this track. DDP only."/>
                            <TextBox Grid.Column="4" Text="{Binding Isrc, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="10.5" Padding="8,4" Margin="0,0,6,0"
                                     BorderBrush="{Binding IsrcBrush}" LostFocus="OnIsrcCommitted"
                                     IsEnabled="{Binding DdpFields}"
                                     ToolTip="Twelve characters; punctuation is ignored. Blank if the track has none."/>
                            <ToggleButton Grid.Column="5" Style="{StaticResource SegmentButton}" Width="30" Height="24"
                                          Margin="0,0,10,0" Padding="0" FontSize="9"
                                          IsChecked="{Binding PreEmphasis}" Content="{Binding EmphasisText}"
                                          IsEnabled="{Binding DdpFields}"
                                          ToolTip="Whether this track was cut with pre-emphasis. DDP only."/>
                            <TextBox x:Name="startEditor" Grid.Column="6" Text="{Binding StartText, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="10.5" Padding="5,4" Margin="0,0,6,0"
                                     ToolTip="Seconds, mm:ss, or hh:mm:ss.mmm" LostFocus="OnRangeEditCommitted"/>
                            <TextBox x:Name="endEditor" Grid.Column="7" Text="{Binding EndText, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="10.5" Padding="5,4" Margin="0,0,8,0"
                                     ToolTip="Seconds, mm:ss, or hh:mm:ss.mmm" LostFocus="OnRangeEditCommitted"/>
                            <TextBlock Grid.Column="8" Text="{Binding CdLengthText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       ToolTip="Length on the disc in minutes, seconds and CD frames, after sector alignment."/>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="20,0,20,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="upBtn" Content="▲" Width="34" Height="30" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnMoveUp"/>
                    <Button x:Name="downBtn" Content="▼" Width="34" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnMoveDown"/>
                    <Button x:Name="addBtn" Content="Add Track" Width="82" Height="30" Margin="10,0,0,0" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}" Click="OnAddTrack"
                            ToolTip="Add a track from the selection, or — with nothing selected — take a three-minute block off the front of the selected track and leave the rest as the next one. Press it again for the next track."/>
                    <Button x:Name="removeBtn" Content="Remove" Width="72" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnRemove"/>
                    <Button x:Name="splitBtn" Content="Split" Width="54" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}" ToolTip="Split at the document cursor, or at the midpoint" Click="OnSplitSelected"/>
                    <Button x:Name="saveRegionsBtn" Content="Sync Regions" Width="100" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnSaveRegions"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,-2" VerticalAlignment="Center">
                    <TextBlock x:Name="validationText" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Muted}" FontSize="10.5"/>
                    <CheckBox x:Name="renderRackCheck" Margin="0,5,0,0" Content="Render the current rack into Preview and exported files"
                              Foreground="{StaticResource Muted}" Checked="OnRenderRackChanged" Unchecked="OnRenderRackChanged"
                              ToolTip="When off, both Preview and export use the unprocessed source."/>
                </StackPanel>
                <Button x:Name="previewBtn" Grid.Column="2" Content="▶ Preview Track" Width="124" Height="30"
                        Style="{StaticResource AccentButton}" Click="OnPreview"/>
            </Grid>

            <Border Grid.Row="6" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <!-- 230 clipped "Export DDP Image Set…" to "Export DDP Image Set."; the label is
                         the longest thing this footer has to hold, so the column is sized to it. -->
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <ProgressBar x:Name="progressBar" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource Accent}"
                                     Background="{StaticResource Panel3}"/>
                        <TextBlock x:Name="statusText" Text="Arrange the proposed tracks, then export a burner-ready package."
                                   Margin="0,7,0,0" FontSize="10.5" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="closeBtn" Content="Close" Height="38" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnClose"/>
                        <Button x:Name="exportBtn" Grid.Column="2" Content="Export CD Package…" Height="38" MinWidth="140" Style="{StaticResource AccentButton}" Click="OnExport"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
