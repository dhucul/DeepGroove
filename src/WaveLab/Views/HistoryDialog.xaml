<Window x:Class="WaveLab.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit History" Width="540" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Amber}" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit History" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="headerDetail" Margin="18,5,0,0" FontSize="10.5"
                               Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- ItemsSource rather than items built in code: a long restoration session can leave
                 thousands of steps here, and only this way does the list build the rows it shows. -->
            <ListBox x:Name="list" Grid.Row="1" Margin="12,10" Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="Edit history steps"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#242A31"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel3}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{Binding DotFill}" Stroke="{Binding DotStroke}" StrokeThickness="1"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                           FontWeight="{Binding NameWeight}" Foreground="{Binding NameBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Note}" FontSize="10.5" Margin="0,2,0,0"
                                           Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                           Visibility="{Binding NoteVisibility}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock Text="&#x25CF;" FontSize="10.5" Margin="0,0,6,0"
                                           Foreground="{StaticResource Green}" ToolTip="Last saved state"
                                           Visibility="{Binding SavepointVisibility}"/>
                                <TextBlock Text="&#x2195;" FontSize="11" Foreground="{StaticResource Amber}"
                                           ToolTip="This step changes the file&apos;s length"
                                           Visibility="{Binding LengthVisibility}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="{StaticResource Muted}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="cautionText" Grid.Row="2" Margin="22,0,22,10" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{StaticResource Amber}" Visibility="Collapsed"/>

            <Border Grid.Row="3" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <UniformGrid Columns="4">
                    <Button x:Name="jumpButton" Style="{StaticResource AccentButton}" Height="33" Margin="2,0"
                            AutomationProperties.Name="Jump to the selected state"
                            Click="OnJumpButton" Content="Jump Here"/>
                    <Button x:Name="deleteButton" Style="{StaticResource DangerButton}" Height="33" Margin="2,0"
                            AutomationProperties.Name="Discard the selected step and everything after it"
                            Click="OnDelete" Content="Delete From Here"/>
                    <Button x:Name="copyButton" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Height="33" Margin="2,0" AutomationProperties.Name="Copy the history as text"
                            Click="OnCopy" Content="Copy List"/>
                    <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="33" Margin="2,0"
                            AutomationProperties.Name="Close the edit history panel"
                            Click="OnClose" Content="Close" IsCancel="True"/>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
