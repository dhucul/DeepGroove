<Window x:Class="WaveLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaveLab.Views.Controls"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/WaveLab;component/Assets/wavelab.ico"
        Width="1680" Height="1010" MinWidth="1180" MinHeight="720"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnFileDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Help}" Executed="OnHelpCommand"/>
    </Window.CommandBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomFitCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RecordCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}"/>
        <KeyBinding Key="Home" Command="{Binding GoToStartCommand}"/>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding AddMarkerCommand}"/>
        <KeyBinding Key="M" Modifiers="Control+Shift" Command="{Binding AddRegionCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PrevMarkerCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextMarkerCommand}"/>
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding CommandPaletteCommand}"/>
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="31"/>
            <!-- Auto, not fixed: the spectral bar stacks under the transport in this row and the
                 row has to grow for it. The transport keeps its own height below. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="27"/>
        </Grid.RowDefinitions>

        <!-- ═══ title bar ═══ -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#181C21" Offset="0"/>
                    <GradientStop Color="#14171B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="#173A36" VerticalAlignment="Center">
                        <Path Data="M2,10 L3.5,10 4.5,6.5 6,13 7.5,3 9,16 10.5,7 11.5,10 17,10"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="9,0,0,0" FontSize="13.5" FontWeight="Bold">
                        <Run Text="WAVE" Foreground="{StaticResource Text}"/><Run Text="LAB" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="22,0,0,0" FontSize="12.5"
                               Foreground="{StaticResource Muted}" Text="{Binding WindowTitle}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" Focusable="False"
                            AutomationProperties.Name="Minimize window">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource Muted}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" Focusable="False"
                            AutomationProperties.Name="Maximize or restore window">
                        <Path Data="M0.5,0.5 L9.5,0.5 9.5,9.5 0.5,9.5 Z" Stroke="{StaticResource Muted}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseWindow" Focusable="False"
                            AutomationProperties.Name="Close WaveLab">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Muted}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ menu ═══ -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
            <Menu VerticalAlignment="Center" Margin="8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="_File">
                    <MenuItem Header="Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                    <MenuItem Header="Open As Bit Depth…" Click="OnOpenAsBitDepth"/>
                    <MenuItem Header="Extract Audio CD…" Click="OnExtractAudioCd"/>
                    <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                    <MenuItem Header="Save As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                    <MenuItem Header="Export…" InputGestureText="Ctrl+E" Command="{Binding ExportCommand}"/>
                    <Separator/>
                    <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding}"/>
                                <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Recording Setup…" Command="{Binding RecordSetupCommand}"/>
                    <Separator/>
                    <MenuItem Header="Close File" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}"/>
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                    <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
                    <Separator/>
                    <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="{Binding CutCommand}"/>
                    <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}"/>
                    <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}"/>
                    <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding DeleteCommand}"/>
                    <Separator/>
                    <MenuItem Header="Trim to Selection" Command="{Binding TrimCommand}"/>
                    <MenuItem Header="Select All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                </MenuItem>
                <MenuItem Header="_View" IsEnabled="{Binding HasAudioDocument}">
                    <MenuItem Header="Zoom In" InputGestureText="Ctrl+=" Command="{Binding ZoomInCommand}"/>
                    <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}"/>
                    <MenuItem Header="Zoom to Fit" InputGestureText="Ctrl+0" Command="{Binding ZoomFitCommand}"/>
                    <MenuItem Header="Zoom to Selection" Command="{Binding ZoomSelectionCommand}"/>
                    <Separator/>
                    <MenuItem Header="Reset Amplitude Zoom" InputGestureText="Ctrl+Wheel" Click="OnResetAmpZoom"/>
                </MenuItem>
                <MenuItem Header="Mar_kers" IsEnabled="{Binding HasDocument}">
                    <MenuItem Header="Add Marker" InputGestureText="Ctrl+M" Command="{Binding AddMarkerCommand}"/>
                    <MenuItem Header="Add Region from Selection" InputGestureText="Ctrl+Shift+M" Command="{Binding AddRegionCommand}"/>
                    <Separator/>
                    <MenuItem Header="Previous Marker" InputGestureText="Alt+←" Command="{Binding PrevMarkerCommand}"/>
                    <MenuItem Header="Next Marker" InputGestureText="Alt+→" Command="{Binding NextMarkerCommand}"/>
                    <Separator/>
                    <MenuItem Header="Manage Markers &amp; Regions…" Click="OnManageMarkers"/>
                    <MenuItem Header="Clear All" Command="{Binding ClearMarkersCommand}"/>
                </MenuItem>
                <MenuItem Header="_Transport">
                    <MenuItem Header="Play / Pause" InputGestureText="Space" Command="{Binding PlayCommand}"/>
                    <MenuItem Header="Stop" Command="{Binding StopCommand}"/>
                    <MenuItem Header="Go to Start" InputGestureText="Home" Command="{Binding GoToStartCommand}"/>
                    <MenuItem Header="Loop" IsCheckable="True" IsChecked="{Binding IsLooping}"/>
                    <Separator/>
                    <MenuItem Header="Arm Recording Input" IsCheckable="True" IsChecked="{Binding IsRecordArmed}"
                              IsEnabled="{Binding CanChangeRecordArm}"/>
                    <MenuItem Header="Record / Stop" InputGestureText="Ctrl+R" Command="{Binding RecordCommand}"/>
                </MenuItem>
                <MenuItem Header="_Process" IsEnabled="{Binding HasAudioDocument}">
                    <MenuItem Header="Gain +3 dB" Command="{Binding GainUpCommand}"/>
                    <MenuItem Header="Gain −3 dB" Command="{Binding GainDownCommand}"/>
                    <MenuItem Header="Normalize to −0.3 dBFS" Command="{Binding NormalizeCommand}"/>
                    <Separator/>
                    <MenuItem Header="Fade In" Command="{Binding FadeInCommand}"/>
                    <MenuItem Header="Fade Out" Command="{Binding FadeOutCommand}"/>
                    <MenuItem Header="Reverse" Command="{Binding ReverseCommand}"/>
                    <MenuItem Header="Remove DC Offset" Command="{Binding RemoveDcCommand}"/>
                    <MenuItem Header="Insert 1 s Silence at Cursor" Command="{Binding InsertSilenceCommand}"/>
                    <MenuItem Header="Smooth Edit Points" Command="{Binding SmoothEditCommand}"/>
                    <Separator/>
                    <MenuItem Header="Silence">
                        <MenuItem Header="Detect Silences → Markers…" Click="OnDetectSilence"/>
                        <MenuItem Header="Trim Silences…" Click="OnTrimSilence"/>
                        <MenuItem Header="Split by Silence → Regions…" Click="OnSplitSilence"/>
                    </MenuItem>
                    <MenuItem Header="Channels">
                        <MenuItem Header="Swap Left ↔ Right" Click="OnSwapChannels" IsEnabled="{Binding HasMultichannelDocument}"/>
                        <MenuItem Header="Invert Phase (All)" Click="OnInvertPhase"/>
                        <MenuItem Header="Invert Phase — Left" Click="OnInvertLeft"/>
                        <MenuItem Header="Invert Phase — Right" Click="OnInvertRight" IsEnabled="{Binding HasMultichannelDocument}"/>
                        <MenuItem Header="Channel Balance…" Click="OnChannelBalance" IsEnabled="{Binding HasMultichannelDocument}"/>
                        <Separator/>
                        <MenuItem Header="Mix Down to Mono → New Tab" Click="OnMonoMixdown"/>
                        <MenuItem Header="Mono → Stereo → New Tab" Click="OnMonoToStereo" IsEnabled="{Binding HasMonoDocument}"/>
                        <MenuItem Header="Extract Left → New Tab" Click="OnExtractLeft"/>
                        <MenuItem Header="Extract Right → New Tab" Click="OnExtractRight" IsEnabled="{Binding HasMultichannelDocument}"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Restore" IsEnabled="{Binding HasAudioDocument}">
                    <MenuItem Header="Vinyl Restoration &amp; CD Transfer…" Click="OnVinylWorkflow"/>
                    <MenuItem Header="Prepare Tracks for Audio CD…" Click="OnPrepareAudioCd"/>
                    <Separator/>
                    <MenuItem Header="Learn Noise Profile from Selection" Click="OnLearnNoise"/>
                    <MenuItem Header="Reduce Noise…" Click="OnReduceNoise"/>
                    <Separator/>
                    <MenuItem Header="Remove Clicks &amp; Pops…" Click="OnRemoveClicks"/>
                    <MenuItem Header="Remove Surface Crackle…" Click="OnRemoveCrackle"/>
                    <MenuItem Header="Remove Hum…" Click="OnRemoveHum"/>
                    <MenuItem Header="Track &amp; Remove Drifting Hum…" Click="OnTrackHum"/>
                    <Separator/>
                    <MenuItem Header="Disc Equalisation Curve…" Click="OnRecordingCurve"/>
                    <MenuItem Header="Correct Stylus Azimuth…" Click="OnCorrectAzimuth"
                              IsEnabled="{Binding HasMultichannelDocument}"/>
                    <MenuItem Header="Correct Wow &amp; Flutter…" Click="OnCorrectWowFlutter"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="Time Stretch…" Click="OnTimeStretch" IsEnabled="{Binding HasAudioDocument}"/>
                    <MenuItem Header="Pitch Shift…" Click="OnPitchShift" IsEnabled="{Binding HasAudioDocument}"/>
                    <MenuItem Header="Convert Sample Rate…" Click="OnConvertRate" IsEnabled="{Binding HasAudioDocument}"/>
                    <Separator/>
                    <MenuItem Header="Detect Pitch (Tuner)" Click="OnTuner" IsEnabled="{Binding HasAudioDocument}"/>
                    <MenuItem Header="Detect Tempo (BPM)" Click="OnBpm" IsEnabled="{Binding HasAudioDocument}"/>
                    <Separator/>
                    <MenuItem Header="Batch Converter…" Click="OnBatchConvert"/>
                    <MenuItem Header="Command Palette" InputGestureText="Ctrl+Shift+P" Command="{Binding CommandPaletteCommand}"/>
                </MenuItem>
                <MenuItem Header="_Analyze" IsEnabled="{Binding HasAudioDocument}">
                    <MenuItem Header="Audio Statistics…" Command="{Binding StatisticsCommand}"/>
                    <MenuItem Header="Refresh Spectrogram" Click="OnRefreshSpectrogram"/>
                </MenuItem>
                <MenuItem Header="_Master" IsEnabled="{Binding HasAudioDocument}">
                    <MenuItem Header="Analyze &amp; Tune Vinyl Cleanup…" Click="OnAnalyzeVinylCleanup"
                              IsEnabled="{Binding CanAnalyzeCleanup}"/>
                    <MenuItem Header="Analyze &amp; Tune Clean Transfer…" Click="OnAnalyzeCleanTransfer"
                              IsEnabled="{Binding CanAnalyzeCleanup}"/>
                    <Separator/>
                    <MenuItem Header="Render in Place (Undoable)" Command="{Binding ApplyChainCommand}"/>
                    <MenuItem Header="Render Copy to New Tab (Source Unchanged)" Command="{Binding RenderCommand}"/>
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem Header="Settings…" Command="{Binding SettingsCommand}"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="WaveLab Help..." InputGestureText="F1"
                              Command="{x:Static ApplicationCommands.Help}"/>
                    <MenuItem Header="Recording and Level Assistant" Tag="recording-levels" Click="OnHelpTopic"/>
                    <MenuItem Header="Keyboard and Mouse Shortcuts" Tag="shortcuts" Click="OnHelpTopic"/>
                    <Separator/>
                    <MenuItem Header="About WaveLab" Command="{Binding AboutCommand}"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ═══ transport ═══ -->
        <!-- Two stacked bars in one grid row, so the spectral bar can appear and disappear without
             renumbering every row below it. -->
        <StackPanel Grid.Row="2">
        <Border Height="62" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#171B20" Offset="0"/>
                    <GradientStop Color="#14171B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="14,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Width="32" Height="32" Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)"
                            AutomationProperties.Name="Open file">
                        <Path Data="M1,4 L1,12 13,12 13,5 6.5,5 5,3 1,3 Z" Stroke="#CFD4DA" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Width="32" Height="32" Margin="6,0,0,0" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)"
                            AutomationProperties.Name="Save active file">
                        <Path Data="M2,2 L10,2 12,4 12,12 2,12 Z M4,2 L4,5.5 9,5.5 9,2 M4,8.5 L10,8.5 10,12 4,12 Z"
                              Stroke="#CFD4DA" StrokeThickness="1.1" StrokeLineJoin="Round"/>
                    </Button>

                    <Rectangle Width="1" Height="34" Fill="{StaticResource Line}" Margin="14,0"/>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding GoToStartCommand}" ToolTip="Go to start (Home)"
                            AutomationProperties.Name="Go to start">
                        <Path Data="M2,1.5 L2,13.5 M13,1.5 L5,7.5 13,13.5 Z" Stroke="#CFD4DA" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="playBtn" Style="{StaticResource ToolButton}" Width="46" Margin="6,0,0,0"
                            Command="{Binding PlayCommand}" ToolTip="Play / Pause (Space)"
                            AutomationProperties.Name="Play or pause">
                        <Grid>
                            <Path Data="M3,1.5 L14.5,8 3,14.5 Z" Fill="{StaticResource Accent}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Grid Width="12" Height="12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="4"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="4" RadiusX="1" RadiusY="1" Fill="{StaticResource Accent}"/>
                                <Rectangle Grid.Column="2" Width="4" RadiusX="1" RadiusY="1" Fill="{StaticResource Accent}"/>
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Command="{Binding StopCommand}" ToolTip="Stop"
                            AutomationProperties.Name="Stop playback or recording">
                        <Rectangle Width="11" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#CFD4DA"/>
                    </Button>
                    <ToggleButton Style="{StaticResource RecordArmButton}" Margin="6,0,0,0"
                                  IsChecked="{Binding IsRecordArmed}" IsEnabled="{Binding CanChangeRecordArm}"
                                  ToolTip="Arm the selected recording input" AutomationProperties.Name="Arm recording input">
                        <TextBlock Text="ARM"/>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Command="{Binding RecordCommand}"
                            ToolTip="{Binding RecordButtonToolTip}" AutomationProperties.Name="Record or stop recording">
                        <Grid>
                            <Ellipse Width="12" Height="12" Fill="{StaticResource Red}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransportRecording}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Rectangle Width="11" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Red}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransportRecording}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Grid>
                    </Button>
                    <ToggleButton Style="{StaticResource ToolButton}" Margin="6,0,0,0" IsChecked="{Binding IsLooping}" ToolTip="Loop playback"
                                  AutomationProperties.Name="Loop playback">
                        <Path Data="M3,8 A5,4.5 0 1 1 4.5,11.2 M3,8 L3,4.5 M3,8 L6.5,8" Stroke="#CFD4DA"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </ToggleButton>

                    <TextBlock Text="{Binding RecordStatusText}" Foreground="{StaticResource Red}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="9,0,0,0" MinWidth="76"/>

                    <Rectangle Width="1" Height="34" Fill="{StaticResource Line}" Margin="14,0"/>

                    <!-- timecode -->
                    <Border Background="#0B0D0F" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="9" Padding="16,5" VerticalAlignment="Center" MinWidth="225">
                        <StackPanel>
                            <TextBlock Text="POSITION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Faint}"/>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="23" Foreground="{StaticResource Accent}"
                                       Text="{Binding ActiveDocument.PositionText, FallbackValue=00:00:00.000}"/>
                        </StackPanel>
                    </Border>

                    <!-- selection readouts -->
                    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                            CornerRadius="9" Padding="16,7" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="SEL IN" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Faint}"/>
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="#CDD3D9"
                                           Text="{Binding ActiveDocument.SelInText, FallbackValue=—}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="SEL OUT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Faint}"/>
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="#CDD3D9"
                                           Text="{Binding ActiveDocument.SelOutText, FallbackValue=—}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="LENGTH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Faint}"/>
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="#CDD3D9"
                                           Text="{Binding ActiveDocument.SelLenText, FallbackValue=—}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0,0,0" IsEnabled="{Binding HasAudioDocument}">
                    <!-- IsChecked is one-way: the mode lives on the view model, so clicking the
                         already-current segment re-asserts rather than unchecking it. -->
                    <ToggleButton Style="{StaticResource SegmentButton}" Content="Waveform"
                                  IsChecked="{Binding IsWaveformView, Mode=OneWay}"
                                  Command="{Binding ShowWaveformCommand}"
                                  ToolTip="Show the waveform only"
                                  AutomationProperties.Name="Waveform view"/>
                    <ToggleButton Style="{StaticResource SegmentButton}" Content="Split" Margin="4,0,0,0"
                                  IsChecked="{Binding IsSplitView, Mode=OneWay}"
                                  Command="{Binding ShowSplitCommand}"
                                  ToolTip="Waveform above, spectrogram below, on one time axis"
                                  AutomationProperties.Name="Split view"/>
                    <ToggleButton Style="{StaticResource SegmentButton}" Content="Spectrogram" Margin="4,0,0,0"
                                  IsChecked="{Binding IsSpectrogramView, Mode=OneWay}"
                                  Command="{Binding ShowSpectrogramCommand}"
                                  ToolTip="Show the spectrogram only"
                                  AutomationProperties.Name="Spectrogram view"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                            CornerRadius="9" Padding="14,8" VerticalAlignment="Center">
                        <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}"
                                   Text="{Binding ActiveDocument.FormatText, FallbackValue=No file loaded}"/>
                    </Border>
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Margin="14,0,0,0"
                            Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out">
                        <Path Data="M5.5,1 A4.5,4.5 0 1 0 5.5,10 A4.5,4.5 0 1 0 5.5,1 M9,9 L12.5,12.5 M3.5,5.5 L7.5,5.5"
                              Stroke="#9AA1A9" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Margin="6,0,0,0"
                            Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl+=)" AutomationProperties.Name="Zoom in">
                        <Path Data="M5.5,1 A4.5,4.5 0 1 0 5.5,10 A4.5,4.5 0 1 0 5.5,1 M9,9 L12.5,12.5 M3.5,5.5 L7.5,5.5 M5.5,3.5 L5.5,7.5"
                              Stroke="#9AA1A9" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Margin="6,0,0,0"
                            Command="{Binding ZoomFitCommand}" ToolTip="Zoom to fit (Ctrl+0)" AutomationProperties.Name="Zoom to fit">
                        <Path Data="M1,5 L1,1 5,1 M9,1 L13,1 13,5 M13,9 L13,13 9,13 M5,13 L1,13 1,9"
                              Stroke="#9AA1A9" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ spectral repair ═══ -->
        <!-- Its own bar, per docs/design/spectral_editor.png. The transport row is already full;
             crammed in beside it the actions were clipped and the view switch collapsed to two
             letters a segment. It appears only with the spectrogram, so waveform mode is untouched. -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Background="{StaticResource Panel}"
                Visibility="{Binding ShowsSpectrogram, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="14,7" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="SPECTRAL" FontSize="9" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Faint}"/>

                <!-- Four tools, because defects have shapes. IsChecked is one-way for the same
                     reason as the view switch: the tool lives on the view model. -->
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SegmentButton}" Height="30"
                              IsChecked="{Binding IsRectangleTool, Mode=OneWay}"
                              Command="{Binding UseRectangleToolCommand}"
                              ToolTip="Rectangle — a time span crossed with a frequency band"
                              AutomationProperties.Name="Rectangle selection tool">
                    <Rectangle Width="13" Height="11" Stroke="#9AA1A9" StrokeThickness="1.3"
                               StrokeDashArray="2.5 2" Fill="Transparent"/>
                </ToggleButton>
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SegmentButton}" Height="30" Margin="4,0,0,0"
                              IsChecked="{Binding IsLassoTool, Mode=OneWay}"
                              Command="{Binding UseLassoToolCommand}"
                              ToolTip="Lasso — follow the shape of the defect"
                              AutomationProperties.Name="Lasso selection tool">
                    <Path Data="M2,7 C2,3 5,1 8,2 C12,3 13,7 10,9 C7,11 3,10 2,7 M6,10 L5,13"
                          Stroke="#9AA1A9" StrokeThickness="1.3" StrokeDashArray="2.5 2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </ToggleButton>
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SegmentButton}" Height="30" Margin="4,0,0,0"
                              IsChecked="{Binding IsMagicWandTool, Mode=OneWay}"
                              Command="{Binding UseMagicWandToolCommand}"
                              ToolTip="Magic wand — grow a region through connected energy"
                              AutomationProperties.Name="Magic wand selection tool">
                    <Path Data="M7,1 L8.4,5 L12.5,6.4 L8.4,7.8 L7,12 L5.6,7.8 L1.5,6.4 L5.6,5 Z"
                          Stroke="#9AA1A9" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                </ToggleButton>
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SegmentButton}" Height="30" Margin="4,0,0,0"
                              IsChecked="{Binding IsHarmonicTool, Mode=OneWay}"
                              Command="{Binding UseHarmonicToolCommand}"
                              ToolTip="Harmonic — a fundamental and its partials together"
                              AutomationProperties.Name="Harmonic selection tool">
                    <Path Data="M1,12 L13,12 M1,9 L13,9 M1,5.5 L13,5.5 M1,1.5 L13,1.5"
                          Stroke="#9AA1A9" StrokeThickness="1.3" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </ToggleButton>

                <Border DockPanel.Dock="Left" Width="1" Margin="12,3" Background="{StaticResource Line}"/>
                <!-- MinWidth rather than Padding: neither the ToolButton nor the AccentButton
                     template binds Padding, so it is silently ignored on both. -->
                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="Heal"
                        Height="30" MinWidth="84"
                        Click="OnSpectralHeal" IsEnabled="{Binding HasSpectralSelection}"
                        ToolTip="Rebuild the selected region from the partials running through it"
                        AutomationProperties.Name="Heal spectral selection"/>
                <!-- Width released: ToolButton is sized for a 38×38 icon. -->
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="Attenuate…"
                        Width="Auto" MinWidth="116" Height="30" Margin="8,0,0,0"
                        Click="OnSpectralAttenuate" IsEnabled="{Binding HasSpectralSelection}"
                        ToolTip="Turn the selected region down, to its surroundings or by a fixed amount"
                        AutomationProperties.Name="Attenuate spectral selection"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="Gain…"
                        Width="Auto" MinWidth="78" Height="30" Margin="6,0,0,0"
                        Click="OnSpectralGain" IsEnabled="{Binding HasSpectralSelection}"
                        ToolTip="Raise or lower the selected region"
                        AutomationProperties.Name="Gain spectral selection"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="Learn pattern…"
                        Width="Auto" MinWidth="128" Height="30" Margin="6,0,0,0"
                        Click="OnSpectralLearnPattern" IsEnabled="{Binding HasSpectralSelection}"
                        ToolTip="Learn this sound's signature and remove it from elsewhere in the file"
                        AutomationProperties.Name="Learn pattern from spectral selection"/>

                <Border DockPanel.Dock="Right" Background="{StaticResource Panel2}"
                        BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                        CornerRadius="9" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SELECTION" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource Faint}"/>
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="#CDD3D9"
                                   Text="{Binding SpectralSpanText, FallbackValue=—}"/>
                        <TextBlock Text="BAND" FontSize="9" FontWeight="SemiBold" Margin="16,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Faint}"/>
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="#CDD3D9"
                                   Text="{Binding SpectralBandText, FallbackValue=—}"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                           FontSize="11" Foreground="{StaticResource Faint}"
                           Text="{Binding SpectralToolHint}"
                           Visibility="{Binding NeedsSpectralSelection, Converter={StaticResource BoolToVis}}"/>
            </DockPanel>
        </Border>
        </StackPanel>

        <!-- ═══ file tabs ═══ -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <ListBox Style="{StaticResource FileTabs}" Margin="10,0,10,-1" VerticalAlignment="Bottom"
                     ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Amber}" Margin="0,0,8,0"
                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Doc.Title}" FontSize="12" Foreground="{StaticResource Text}"/>
                            <Button Margin="8,0,0,0" Padding="2" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Faint}" Cursor="Hand"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="Close file tab">
                                <TextBlock Text="×" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ═══ main ═══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="308"/>
            </Grid.ColumnDefinitions>

            <!-- editor column -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="252"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,1,0">
                    <TextBlock Text="dBFS" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                               Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </Border>
                <c:OverviewBar Grid.Row="0" Grid.Column="1" Document="{Binding ActiveDocument}" SeekCommand="{Binding SeekCommand}"/>
                <c:TimeRuler Grid.Row="1" Grid.Column="1" Document="{Binding ActiveDocument}"/>
                <!-- Waveform and spectrogram share one time axis, one zoom and one playhead, so the
                     overview bar, time ruler and transport above keep working unchanged whichever
                     mode is showing. Row heights are set in code when the mode changes. -->
                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="waveformRow" Height="*"/>
                        <RowDefinition x:Name="splitterRow" Height="0"/>
                        <RowDefinition x:Name="spectralRow" Height="0"/>
                    </Grid.RowDefinitions>

                <c:AmplitudeRuler Grid.Row="0" Grid.Column="0" Document="{Binding ActiveDocument}"/>
                <c:WaveformView Grid.Row="0" Grid.Column="1" Document="{Binding ActiveDocument}"
                                SeekCommand="{Binding SeekCommand}" IsPlaybackActive="{Binding IsActiveDocumentPlaying}">
                    <c:WaveformView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="{Binding CutCommand}"/>
                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}"/>
                            <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}"/>
                            <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding DeleteCommand}"/>
                            <Separator/>
                            <MenuItem Header="Trim to Selection" Command="{Binding TrimCommand}"/>
                            <MenuItem Header="Select All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="Zoom to Selection" Command="{Binding ZoomSelectionCommand}"/>
                        </ContextMenu>
                    </c:WaveformView.ContextMenu>
                </c:WaveformView>

                    <GridSplitter x:Name="editorSplitter" Grid.Row="1" Grid.ColumnSpan="2"
                                  Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource Line}" ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows" Visibility="Collapsed"
                                  AutomationProperties.Name="Resize the waveform and spectrogram panes"/>

                    <c:FrequencyRuler x:Name="frequencyRuler" Grid.Row="2" Grid.Column="0"
                                      Document="{Binding ActiveDocument}"/>
                    <!-- Two-way: dragging on the spectrogram fills the toolbar's readout, and the
                         view model clearing the selection erases the drawn rectangle. Bound rather
                         than pushed one way, so the two can never disagree about what is selected. -->
                    <c:SpectralEditorView x:Name="spectralEditor" Grid.Row="2" Grid.Column="1"
                                          Document="{Binding ActiveDocument}"
                                          Tool="{Binding SpectralTool}"
                                          Selection="{Binding SpectralSelection, Mode=TwoWay}"/>
                </Grid>

                <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <TabControl x:Name="analysisTabs" SelectionChanged="OnAnalysisTabChanged">
                        <TabItem Header="Spectrum">
                            <c:SpectrumView x:Name="spectrumView"/>
                        </TabItem>
                        <TabItem Header="Spectrogram">
                            <c:SpectrogramView x:Name="spectrogramView"/>
                        </TabItem>
                        <TabItem Header="Loudness History">
                            <c:LoudnessHistoryView x:Name="loudnessView"/>
                        </TabItem>
                        <TabItem Header="Phase">
                            <c:PhaseView x:Name="phaseView"/>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- master rack -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="14,0" VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Master.RackStateText}" Margin="0,0,7,0" FontSize="8.5"
                                           FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Master.RackEnabled}"
                                              ToolTip="Enable or bypass the entire effects rack"
                                              AutomationProperties.Name="Enable or bypass effects rack"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Master.RackEnabled}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource Faint}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="MASTER RACK" Margin="8,0,0,0" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- preset row -->
                    <StackPanel Grid.Row="1">
                        <Grid Margin="12,10,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Height="30" ItemsSource="{Binding Master.PresetNames}"
                                      SelectedItem="{Binding Master.SelectedPreset}" ToolTip="Load a chain preset"
                                      AutomationProperties.Name="Effects rack preset"/>
                            <Button Grid.Column="1" Style="{StaticResource ToolButton}" Width="30" Height="30" Margin="6,0,0,0"
                                    Command="{Binding Master.SavePresetCommand}" ToolTip="Save current chain as preset"
                                    AutomationProperties.Name="Save rack preset">
                                <Path Data="M2,2 L10,2 12,4 12,12 2,12 Z M4,2 L4,5.5 9,5.5 9,2 M4,8.5 L10,8.5 10,12 4,12 Z"
                                      Stroke="#9AA1A9" StrokeThickness="1.1" StrokeLineJoin="Round"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Width="30" Height="30" Margin="6,0,0,0"
                                    Command="{Binding Master.ResetChainCommand}" ToolTip="Reset chain to EQ + Limiter"
                                    AutomationProperties.Name="Reset effects rack">
                                <Path Data="M3,7 A5,4.5 0 1 1 4.5,10.2 M3,7 L3,3.5 M3,7 L6.5,7" Stroke="#9AA1A9"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="analyzeCleanupBtn" Grid.Column="3" Style="{StaticResource ToolButton}"
                                    Width="30" Height="30" Margin="6,0,0,0" Content="✦" FontSize="13"
                                    Foreground="{StaticResource Accent}" Click="OnAnalyzeCleanupMenu"
                                    IsEnabled="{Binding CanAnalyzeCleanup}"
                                    ToolTip="Analyze this file and tune Vinyl Cleanup or Clean Transfer"
                                    AutomationProperties.Name="Analyze and tune cleanup"/>
                        </Grid>
                        <TextBlock Text="{Binding Master.RackStatusText}" Margin="14,5,12,0" FontSize="9.5"
                                   Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- rack -->
                    <ScrollViewer Grid.Row="2" Margin="12,10,6,0" Padding="0,0,6,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Master.Effects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardFaceplate}" BorderBrush="{StaticResource CardEdge}"
                                                BorderThickness="1" CornerRadius="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Border Style="{StaticResource CategoryStrip}" Margin="5,10,0,10" HorizontalAlignment="Left"/>
                                                <StackPanel Margin="16,9,10,10">
                                                    <DockPanel>
                                                        <Border Background="{StaticResource WellDeep}" BorderBrush="{StaticResource LineSoft}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NumberText}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="9" Foreground="{StaticResource Faint}"/>
                                                        </Border>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ToggleButton Style="{StaticResource PowerLed}" IsChecked="{Binding Enabled}"
                                                                          ToolTip="Enable or bypass this effect" AutomationProperties.Name="Enable or bypass effect"/>
                                                            <Button Style="{StaticResource MiniButton}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                    Command="{Binding MoveUpCommand}" ToolTip="Move up" Content="▲" FontSize="8" AutomationProperties.Name="Move effect up"/>
                                                            <Button Style="{StaticResource MiniButton}" VerticalAlignment="Center"
                                                                    Command="{Binding MoveDownCommand}" ToolTip="Move down" Content="▼" FontSize="8" AutomationProperties.Name="Move effect down"/>
                                                            <Button Style="{StaticResource MiniButton}" VerticalAlignment="Center"
                                                                    Command="{Binding ResetCommand}" ToolTip="Set to defaults" Content="↺" FontSize="11" AutomationProperties.Name="Reset effect parameters"/>
                                                            <Button Style="{StaticResource MiniButton}" VerticalAlignment="Center" Command="{Binding RemoveCommand}"
                                                                    ToolTip="Remove from rack and stop processing" Content="✕" FontSize="10" AutomationProperties.Name="Remove effect"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="7.5" FontWeight="Bold"
                                                                       Foreground="{StaticResource Faint}" Margin="0,1.5,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,8,0,0"/>
                                                    <StackPanel x:Name="body">
                                                        <Border Background="{StaticResource MeterBg}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                                                                CornerRadius="6" Padding="4,3" Margin="0,7,0,2"
                                                                Visibility="{Binding IsEq, Converter={StaticResource BoolToVis}}">
                                                            <c:EqCurve Height="46"
                                                                       LowGainDb="{Binding EqLow}" LowMidGainDb="{Binding EqLowMid}" MidGainDb="{Binding EqMid}" HighMidGainDb="{Binding EqHighMid}" HighGainDb="{Binding EqHigh}"/>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Params}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2.5">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="82"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" FontSize="8.5" FontWeight="Bold"
                                                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                                                        <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                                Value="{Binding Value}" Margin="2,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}"/>
                                                                        <Border Grid.Column="2" Background="{StaticResource WellDeep}" BorderBrush="{StaticResource LineSoft}"
                                                                                BorderThickness="1" CornerRadius="4" Padding="7,1" MinWidth="58" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}"
                                                                                       FontSize="9.5" Foreground="#C6CBD1" TextAlignment="Center"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding Readout}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                                   Foreground="{StaticResource Amber}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                                   Visibility="{Binding HasReadout, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="body" Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="addFxBtn" Click="OnAddEffect" Cursor="Hand" AutomationProperties.Name="Add effect">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Margin="0,1,0,0">
                                            <Rectangle x:Name="dash" RadiusX="10" RadiusY="10" Stroke="{StaticResource Line}"
                                                       StrokeThickness="1.2" StrokeDashArray="5 4"/>
                                            <TextBlock x:Name="txt" Text="＋  Add Effect" FontSize="11.5" Foreground="{StaticResource Faint}"
                                                       HorizontalAlignment="Center" Margin="0,10"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="dash" Property="Stroke" Value="#2E5A54"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Muted}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- meters strip -->
                    <Border Grid.Row="3" Background="{StaticResource Panel2}" BorderBrush="{StaticResource LineSoft}"
                            BorderThickness="1" CornerRadius="10" Margin="12,10,12,0" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <c:LevelMeter Width="14" Height="118" PeakDb="{Binding Master.PeakLDb}" RmsDb="{Binding Master.RmsLDb}" PeakHoldDb="{Binding Master.HoldLDb}"/>
                                <c:LevelMeter Width="14" Height="118" Margin="6,0,0,0" PeakDb="{Binding Master.PeakRDb}" RmsDb="{Binding Master.RmsRDb}" PeakHoldDb="{Binding Master.HoldRDb}"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="LUFS INT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Master.LufsIntText}" FontFamily="{StaticResource MonoFont}" FontSize="15" Foreground="{StaticResource Accent}" TextAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="SHORT-TERM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Master.LufsSText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#DFE4E9" TextAlignment="Right"/>
                                <TextBlock Grid.Row="2" Text="TRUE PEAK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Master.TruePeakText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Green}" TextAlignment="Right"/>
                                <TextBlock Grid.Row="3" Text="RANGE (LU)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Master.LraText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#DFE4E9" TextAlignment="Right"/>
                                <TextBlock Grid.Row="4" Text="CORRELATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Master.CorrelationText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#DFE4E9" TextAlignment="Right"/>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource MiniButton}" Width="24" Height="24" Margin="7,0,0,0"
                                    VerticalAlignment="Top" Command="{Binding Master.ResetMetersCommand}"
                                    ToolTip="Reset level and loudness meters" AutomationProperties.Name="Reset meters">
                                <Path Data="M3,7 A5,4.5 0 1 1 4.5,10.2 M3,7 L3,3.5 M3,7 L6.5,7"
                                      Stroke="#9AA1A9" StrokeThickness="1.3" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- action buttons -->
                    <Grid Grid.Row="4" Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="46"
                                Command="{Binding ApplyChainCommand}" ToolTip="Render the selection or whole file in this tab as one undoable edit"
                                AutomationProperties.Name="Render effects in place">
                            <StackPanel>
                                <TextBlock Text="Render in Place" FontSize="11.5" HorizontalAlignment="Center"/>
                                <TextBlock Text="UNDOABLE · SELECTION OR FILE" Margin="0,2,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="8.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" Height="46" Command="{Binding RenderCommand}"
                                AutomationProperties.Name="Render effects to a new file tab"
                                ToolTip="Render the whole file through the chain into a new tab without changing the source">
                            <StackPanel>
                                <TextBlock Text="Render Copy" FontSize="11.5" HorizontalAlignment="Center"/>
                                <TextBlock Text="SOURCE UNCHANGED · NEW TAB" Margin="0,2,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="8.5" Foreground="#8DD7CC" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ status bar ═══ -->
        <Border Grid.Row="5" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusEngine}" Margin="7,0,0,0" FontSize="11" Foreground="{StaticResource Faint}"/>
                    <TextBlock Text="{Binding StatusSamples}" Margin="22,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                    <TextBlock Margin="22,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}">
                        <Run Text="Sel "/><Run Text="{Binding ActiveDocument.SelLenText, Mode=OneWay, FallbackValue=—}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusAutosave}" Margin="22,0,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"/>

                    <!-- Background work: reported here so the editor stays usable while it runs. -->
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center"
                                DataContext="{Binding Progress.Background}"
                                Visibility="{Binding DataContext.Progress.IsBackgroundVisible,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="10.5"
                                   Foreground="{StaticResource Muted}"/>
                        <ProgressBar Width="132" Height="4" Margin="9,0,0,0" VerticalAlignment="Center"
                                     Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Background="{StaticResource Line}" Foreground="{StaticResource Accent}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding PercentText}" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Foreground="{StaticResource Muted}"/>
                        <Button Content="✕" Margin="7,0,0,0" Width="18" Height="16"
                                VerticalAlignment="Center" FontSize="10"
                                Style="{StaticResource ToolButton}" Foreground="{StaticResource Faint}"
                                Command="{Binding CancelCommand}"
                                ToolTip="Cancel this background task"
                                AutomationProperties.Name="Cancel background task"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}">
                        <Run Text="Zoom "/><Run Text="{Binding ActiveDocument.ZoomText, Mode=OneWay, FallbackValue=—}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding CpuText}" Margin="20,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding RamText}" Margin="20,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock Text="{Binding ActionStatusText}" Margin="22,0" VerticalAlignment="Center"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{StaticResource Green}"
                           ToolTip="{Binding ActionStatusText}"
                           AutomationProperties.Name="{Binding ActionStatusText}"
                           AutomationProperties.HelpText="Last completed action"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>

        <!-- ═══ blocking-operation overlay ═══
             Spans the menu bar down through the status bar, deliberately: the whole point is that a
             second document-mutating command cannot be started while one is running, and the window
             cannot simply be disabled because that would take the Cancel button with it. Row 0, the
             title bar, stays live so the window can still be moved and closed. -->
        <c:ProgressOverlay Grid.Row="1" Grid.RowSpan="5" Panel.ZIndex="100"
                           DataContext="{Binding Progress}"/>

    </Grid>
</Window>
