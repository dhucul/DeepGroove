<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WaveLab</RootNamespace>
    <AssemblyName>WaveLab</AssemblyName>
    <!-- Program.Main runs ahead of WPF so a plugin scan never starts an application. -->
    <StartupObject>WaveLab.Program</StartupObject>
    <Version>2.0.43</Version>
    <!-- Display name only. AssemblyName stays WaveLab: pack:// resource URIs, the VST3 scanner's
         re-run of its own exe, and the %AppData%\WaveLab data folder all resolve on that name. -->
    <Product>Deep Groove</Product>
    <Description>Audio editor and mastering suite for Windows</Description>
    <ApplicationIcon>Assets\wavelab.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- VST3 is a C++ vtable ABI. The interop in Audio/Vst3 dispatches through it with function
         pointers rather than CLR COM interop: the layouts are then written down explicitly where
         they can be checked, and no RCW lifetime rule sits between this app and a plugin. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WaveLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\wavelab.ico" />
  </ItemGroup>

</Project>
