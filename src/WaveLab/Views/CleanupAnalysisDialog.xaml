<Window x:Class="WaveLab.Views.CleanupAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup Analysis" Width="960" Height="760" MinWidth="860" MinHeight="660"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False"
        Closing="OnWindowClosing">

    <Window.Resources>
        <Style x:Key="AnalysisCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="UpperLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="10" Opacity="0.65" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,14"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#173A36"
                                BorderBrush="#2E5A54" BorderThickness="1">
                            <TextBlock Text="&#x2726;" Foreground="{StaticResource Accent}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0">
                            <TextBlock x:Name="titleText" Text="Cleanup · Analyze &amp; Tune"
                                       FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Evidence-based rack settings · source audio remains untouched"
                                       Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x00D7;" Style="{StaticResource CaptionCloseButton}"
                            FontSize="18" Height="34" Click="OnClose"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,13,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ANALYZED SOURCE" Style="{StaticResource UpperLabel}"/>
                    <TextBlock x:Name="sourceText" Text="Preparing source range…" Margin="0,5,0,0"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="ANALYSIS STATUS" Style="{StaticResource UpperLabel}"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="analysisSummaryText" Text="Waiting to analyze" Margin="0,5,0,0"
                               Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="20,0,12,0">
                <StackPanel x:Name="resultsHost" Margin="0,0,8,14" IsEnabled="False">
                    <TextBlock Text="WHAT THE ANALYZER FOUND" Style="{StaticResource UpperLabel}"
                               Margin="0,0,0,7"/>
                    <ItemsControl x:Name="metricsItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AnalysisCard}" Margin="0,0,8,10" MinHeight="88">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource UpperLabel}"/>
                                        <TextBlock Text="{Binding Value}" Margin="0,6,0,0" FontSize="12.5"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Evidence}" Margin="0,4,0,0" FontSize="10.5"
                                                   Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,3,0,7">
                        <TextBlock x:Name="recommendationTitle" Text="RECOMMENDED CLEANUP SETTINGS"
                                   Style="{StaticResource UpperLabel}"/>
                        <TextBlock Text="Uncheck any processor you want to leave at its factory setting"
                                   HorizontalAlignment="Right" Foreground="{StaticResource Faint}"
                                   FontSize="10.5"/>
                    </Grid>

                    <ItemsControl x:Name="recommendationItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AnalysisCard}" Padding="13,11" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="175"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="245"/>
                                            <ColumnDefinition Width="82"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Checked="OnRecommendationSelectionChanged"
                                                  Unchecked="OnRecommendationSelectionChanged"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="4,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Evidence}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Muted}" FontSize="10.5"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="FACTORY BASELINE → RECOMMENDED" Style="{StaticResource UpperLabel}"/>
                                            <TextBlock Text="{Binding Transition}" Margin="0,4,0,0"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ConfidenceText}" Foreground="{StaticResource Accent}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="confidence" Style="{StaticResource UpperLabel}"
                                                       Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#14241F" BorderBrush="#285044" BorderThickness="1"
                            CornerRadius="9" Padding="13,10" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓  Conservative limits applied" Foreground="{StaticResource Green}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="safetyText"
                                       Text="Settings are checked against quiet and musical passages, transients, and stereo integrity."
                                       Margin="13,0,0,0" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="statusText" Text="Ready to analyze." Foreground="{StaticResource Muted}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="progressBar" Minimum="0" Maximum="1" Value="0"
                                     Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="reanalyzeBtn" Content="Re-analyze" Width="94" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryAction}" Click="OnReanalyze"/>
                        <Button x:Name="previewBtn" Content="▶ A/B Preview" Width="112" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryAction}" Click="OnPreview"/>
                        <Button x:Name="applyBtn" Content="Apply to Rack" Width="112" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryAction}" Click="OnApply"/>
                        <Button x:Name="cancelBtn" Content="Cancel" Width="82"
                                Style="{StaticResource SecondaryAction}" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
