<Window x:Class="WaveLab.Views.BatchConvertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Converter" Width="580" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="Batch Converter" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MiniButton}" Click="OnAddFiles" Content="＋ Add Files" FontSize="10.5"/>
                        <Button Style="{StaticResource MiniButton}" Click="OnClearFiles" Content="Clear" FontSize="10.5" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="16,12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="9">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="fileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="16,0,16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FORMAT" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="cmbFormat" Margin="0,5,0,0" Height="32" AutomationProperties.Name="Output format"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NORMALIZE" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="cmbNormalize" Margin="0,5,0,0" Height="32" AutomationProperties.Name="Normalization"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="EFFECT CHAIN" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="cmbChain" Margin="0,5,0,0" Height="32" AutomationProperties.Name="Effects chain"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="OUTPUT FOLDER" Margin="0,12,0,0" Style="{StaticResource UpperLabel}"/>
                <DockPanel Margin="0,5,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Height="32" Width="80" Margin="8,0,0,0" Click="OnBrowse" Content="Browse…"/>
                    <TextBox x:Name="txtOutput" Height="32" AutomationProperties.Name="Output folder"/>
                </DockPanel>
                <ProgressBar x:Name="progress" Margin="0,12,0,0"/>
                <TextBlock x:Name="statusText" Margin="0,6,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"/>
            </StackPanel>

            <Border Grid.Row="3" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCancel" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Height="36" Click="OnCancel" Content="Close"/>
                    <Button x:Name="btnStart" Grid.Column="2" Style="{StaticResource AccentButton}" Height="36"
                            Click="OnStart" Content="Start" IsDefault="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
