<Window x:Class="WaveLab.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveLab" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="20,18">
            <TextBlock x:Name="promptText" Text="Name" FontSize="13.5" FontWeight="SemiBold"/>
            <TextBox x:Name="input" Margin="0,12,0,0" KeyDown="OnKeyDown"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="34"
                        Click="OnCancel" Content="Cancel" IsCancel="True"/>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Height="34" Click="OnOk" Content="OK"
                        IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
