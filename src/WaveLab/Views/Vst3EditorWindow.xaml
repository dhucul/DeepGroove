<Window x:Class="WaveLab.Views.Vst3EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource Panel2}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource WindowEdge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="14,10"
                    MouseLeftButtonDown="OnDragMove" Background="{StaticResource Panel}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="pluginName" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="pluginVendor" Margin="12,1,0,0" FontSize="10.5"
                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="latencyText" Margin="0,0,12,0" FontSize="10.5"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="24" Height="22" FontSize="10.5"
                                Style="{StaticResource ToolButton}" Foreground="{StaticResource Muted}"
                                Click="OnClose" AutomationProperties.Name="Close plugin editor"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The plugin's own window goes here. Nothing is drawn over it: an HwndHost is an
                 airspace island and WPF content on top of it would not be composited. -->
            <Border x:Name="editorFrame" Grid.Row="1" Background="#000000"/>

            <Border x:Name="fallbackPanel" Grid.Row="2" Padding="16,14" Visibility="Collapsed"
                    Background="{StaticResource Panel2}">
                <StackPanel MaxWidth="420">
                    <TextBlock x:Name="fallbackTitle" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="fallbackText" Margin="0,8,0,0" FontSize="10.5"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
