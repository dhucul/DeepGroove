<Window x:Class="WaveLab.Views.MarkersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markers &amp; Regions" Width="480" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Amber}" VerticalAlignment="Center"/>
                    <TextBlock Text="Markers &amp; Regions" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <ListBox x:Name="list" Grid.Row="1" Margin="12,10" Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="Markers and regions"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnJump">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#242A31"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel3}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <UniformGrid Columns="4">
                    <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="33" Margin="2,0"
                            Click="OnJumpButton" Content="Go To"/>
                    <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="33" Margin="2,0"
                            Click="OnRename" Content="Rename"/>
                    <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="33" Margin="2,0"
                            Click="OnDelete" Content="Delete"/>
                    <Button Style="{StaticResource AccentButton}" Height="33" Margin="2,0" Click="OnClose" Content="Close" IsCancel="True"/>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
