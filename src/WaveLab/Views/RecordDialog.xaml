<Window x:Class="WaveLab.Views.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaveLab.Views.Controls"
        Title="Record Audio" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- The target-ceiling chip: a readout at rest, a button on approach. -->
        <Style x:Key="CeilingChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9FD8CF"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#152724" BorderBrush="#2E5A52" BorderThickness="1"
                                CornerRadius="6" Padding="8,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B3531"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,16"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                    <TextBlock Text="Record Audio" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
            <StackPanel Margin="20,17,20,16">
                <TextBlock Text="INPUT DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                <ComboBox x:Name="deviceCombo" Margin="0,6,0,0" ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="Input device">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Margin="0,5,0,0"
                      Visibility="{Binding HasDeviceMemory, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DeviceMemoryText}" FontSize="10.5" Foreground="#7FA69F"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="The safest level-check outcome remembered for this input"/>
                    <Button Grid.Column="1" x:Name="useRememberedBtn" Content="Use last setting"
                            Margin="8,0,0,0" FontSize="10" Style="{StaticResource MiniButton}"
                            Foreground="{StaticResource Accent}"
                            IsEnabled="{Binding CanUseRememberedSetting}" Click="OnUseRememberedSetting"
                            AutomationProperties.Name="Restore the input setting remembered for this device"
                            ToolTip="Sets the device level and fine trim back to what this input used last time"/>
                    <Button Grid.Column="2" x:Name="forgetMemoryBtn" Content="Forget"
                            Margin="6,0,0,0" FontSize="10" Style="{StaticResource MiniButton}"
                            IsEnabled="{Binding CanForgetDeviceMemory}"
                            Click="OnForgetDeviceMemory"
                            AutomationProperties.Name="Forget the remembered setting for this device"
                            ToolTip="Discards this input's remembered calibration"/>
                </Grid>

                <StackPanel x:Name="inputGainControls">
                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DEVICE INPUT LEVEL" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Faint}"/>
                    <TextBlock Grid.Column="1" Text="{Binding InputLevelText}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource Accent}"/>
                </Grid>
                <Slider x:Name="inputLevelSlider" Margin="0,6,0,0"
                        Minimum="{Binding InputLevelMinimumDb}"
                        Maximum="{Binding InputLevelMaximumDb}"
                        TickFrequency="{Binding InputLevelStepDb}"
                        SmallChange="{Binding InputLevelStepDb}"
                        LargeChange="3"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        IsEnabled="{Binding HasInputLevelControl}"
                        Value="{Binding InputLevelDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Windows device input level in decibels"/>
                <TextBlock Text="{Binding InputLevelStatusText}" Margin="0,4,0,0" FontSize="10.5"
                           Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WAVELAB FINE TRIM" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Faint}"/>
                    <TextBlock Grid.Column="1" Text="{Binding InputFineTrimText}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource Accent}"/>
                </Grid>
                <Slider x:Name="fineTrimSlider" Margin="0,6,0,0"
                        Minimum="-3" Maximum="0" TickFrequency="0.1"
                        SmallChange="0.1" LargeChange="0.5"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        Value="{Binding InputFineTrimDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="WaveLab fine input trim in decibels"/>
                <TextBlock Text="{Binding InputTotalLevelText}" Margin="0,4,0,0" FontSize="10.5"
                           Foreground="{StaticResource Faint}"
                           ToolTip="Fine Trim is attenuation after the device input; it cannot repair converter or preamp clipping."/>
                </StackPanel>

                <CheckBox Content="Software Playthrough (Input Monitoring)" Margin="0,11,0,0"
                          IsChecked="{Binding SoftwarePlaythroughEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Listen to the fine-trimmed input through WaveLab's selected output device"/>
                <TextBlock Text="{Binding SoftwarePlaythroughStatusText}" Margin="22,4,0,0" FontSize="10.5"
                           Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>

                <TextBlock Text="FORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"
                           Margin="0,13,0,0"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="12,9" Margin="0,6,0,0">
                    <TextBlock Text="{Binding FormatText}" Foreground="#CDD3D9" FontSize="12"/>
                </Border>

                <Grid Margin="0,14,0,0">
                    <TextBlock Text="INPUT LEVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBlock Text="Peak · RMS · held peak" HorizontalAlignment="Right" FontSize="10"
                               Foreground="{StaticResource Faint}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="L" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center"/>
                    <c:LevelMeter Grid.Column="1" Height="16" Orientation="Horizontal" ShowTargetRange="True"
                                  PeakDb="{Binding PeakLDb}" RmsDb="{Binding RmsLDb}" PeakHoldDb="{Binding HoldLDb}"
                                  TargetMinimumDb="{Binding TargetMeterMinimumDb}"
                                  TargetMaximumDb="{Binding TargetMeterMaximumDb}"/>
                    <TextBlock Grid.Row="2" Text="R" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <c:LevelMeter Grid.Row="2" Grid.Column="1" Height="16" Orientation="Horizontal" ShowTargetRange="True"
                                  PeakDb="{Binding PeakRDb}" RmsDb="{Binding RmsRDb}" PeakHoldDb="{Binding HoldRDb}"
                                  TargetMinimumDb="{Binding TargetMeterMinimumDb}"
                                  TargetMaximumDb="{Binding TargetMeterMaximumDb}"/>
                </Grid>
                <Grid Margin="18,4,0,0" TextElement.FontFamily="{StaticResource MonoFont}"
                      TextElement.FontSize="9" TextElement.Foreground="{StaticResource Faint}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="6*"/><ColumnDefinition Width="6*"/><ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="−60"/>
                    <TextBlock Grid.Column="1" Text="−36" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="−24" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="−18" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="−12" Margin="-9,0,0,0"/>
                    <TextBlock Grid.Column="5" Text="−6" Margin="-6,0,0,0"/>
                    <TextBlock Grid.Column="5" Text="0" HorizontalAlignment="Right"/>
                </Grid>

                <Border Background="#111C1B" BorderBrush="#2D514B" BorderThickness="1" CornerRadius="10"
                        Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ceilingChipBtn" Style="{StaticResource CeilingChip}"
                                        Click="OnOpenTargetCeiling"
                                        AutomationProperties.Name="Change the recording level assistant target ceiling"
                                        ToolTip="Peak this transfer is aimed at — click to change it without leaving the dialog">
                                    <TextBlock><Run Text="{Binding TargetCeilingText, Mode=OneWay}"/><Run Text=" ▾" FontSize="7.5"/></TextBlock>
                                </Button>
                                <TextBlock Text="{Binding SafetyReserveText}" Margin="7,0,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="#7FA69F"
                                           VerticalAlignment="Center"
                                           ToolTip="Held back for transients the scan has not seen yet — derived, not set"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Recording Level Assistant" Margin="8,0,0,0" FontWeight="SemiBold"
                                           Foreground="#D7F8F2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <Popup x:Name="ceilingPopup" PlacementTarget="{Binding ElementName=ceilingChipBtn}"
                               Placement="Bottom" HorizontalOffset="-104" VerticalOffset="4"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               Opened="OnTargetCeilingOpened" Closed="OnTargetCeilingClosed">
                            <Border Background="#141E1D" BorderBrush="#336057" BorderThickness="1" CornerRadius="9"
                                    Padding="14,12,15,14" Margin="14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.62" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel Width="290">
                                    <TextBlock Text="TARGET CEILING" FontSize="9" FontWeight="Bold"
                                               Foreground="#7FA69F"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Slider x:Name="sldCardCeiling" Width="186" VerticalAlignment="Center"
                                                AutomationProperties.Name="Target ceiling"
                                                ValueChanged="OnCardCeilingChanged"
                                                Thumb.DragCompleted="OnCeilingDragCompleted"/>
                                        <TextBlock x:Name="lblCardCeiling" Margin="12,0,0,0"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                   Foreground="#CFFFF4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Canvas x:Name="cardCeilingLandmarks" Width="186" Height="16" Margin="0,1,0,0"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="9.5" Foreground="#6E8B86" TextWrapping="Wrap"
                                               LineHeight="15"
                                               Text="Lower leaves more room for the declicking and peak reconstruction that follow a transfer. A running scan re-derives from what it has already measured — nothing restarts."/>
                                    <TextBlock Margin="0,7,0,0" FontSize="9.5" Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap" LineHeight="15"
                                               Visibility="{Binding CeilingChangeDiscardsHeldCheck, Converter={StaticResource BoolToVis}}"
                                               Text="The finished check was measured against the current ceiling and will be discarded — run it again afterwards."/>
                                    <DockPanel Margin="0,13,0,0">
                                        <Button DockPanel.Dock="Right" Content="Done" FontSize="10"
                                                Style="{StaticResource MiniButton}" Foreground="{StaticResource Accent}"
                                                Click="OnCloseTargetCeiling"/>
                                        <Button x:Name="resetCeilingBtn" HorizontalAlignment="Left" FontSize="10"
                                                Style="{StaticResource MiniButton}" Click="OnResetTargetCeiling"
                                                AutomationProperties.Name="Reset the target ceiling to the default"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="232"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding LevelStatusTitle}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#DDF5EF"/>
                                <TextBlock Text="{Binding LevelStatusDetail}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="#95A7A3" FontSize="11.5" LineHeight="17"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#172724" BorderBrush="#37675E" BorderThickness="1"
                                    CornerRadius="8" Padding="11,8" VerticalAlignment="Top"
                                    ToolTip="Held conservatively across everything scanned. Play the whole side for a whole-record setting.">
                                <StackPanel>
                                    <TextBlock Text="SAFE SETTING FOR THIS SIDE" FontSize="8.5" FontWeight="Bold"
                                               Foreground="#77958E" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding RecommendedInputSettingText}" Margin="0,4,0,0"
                                               FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"
                                               Foreground="#CFFFF4" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding RecommendedInputBreakdownText}" Margin="0,4,0,0"
                                               FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                               Foreground="#77958E" TextWrapping="Wrap" TextAlignment="Right"/>
                                    <Button x:Name="applyRecommendationBtn" Margin="0,9,0,0" Height="27"
                                            Style="{StaticResource AccentButton}" FontSize="11"
                                            Content="{Binding ApplyRecommendationText}"
                                            IsEnabled="{Binding CanApplyRecommendedInputSetting}"
                                            Click="OnApplyRecommendation"
                                            AutomationProperties.Name="Apply the recommended device level and fine trim"
                                            ToolTip="Sets the Windows device level and WaveLab fine trim to the safe setting, then restarts the measurement"/>
                                    <TextBlock Text="{Binding ApplyRecommendationStatusText}" Margin="0,5,0,0"
                                               FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                               Foreground="#77958E" TextWrapping="Wrap" TextAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8">
                                <StackPanel><TextBlock Text="TRUE PEAK" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="Absolute 4× oversampled peak, including isolated artifacts"/>
                                    <TextBlock Text="{Binding TruePeakText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="PROG PEAK" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="Click-resistant programme peak that drives the gain recommendation"/>
                                    <TextBlock Text="{Binding ProgramPeakText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="CLICKS ABOVE" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="How far isolated clicks sit above the programme; excluded from the recommendation"/>
                                    <TextBlock Text="{Binding ClickMarginText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="PROJECTED" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="Programme peak plus the unseen-transient safety reserve"/>
                                    <TextBlock Text="{Binding ProjectedPeakText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="PROG RMS" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding ProgramRmsText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="5" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="LOUDNESS" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="EBU R128 integrated loudness of the scanned passage"/>
                                    <TextBlock Text="{Binding LoudnessText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8">
                                <StackPanel><TextBlock Text="CREST" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding CrestFactorText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="NOISE FLOOR" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="Quiet-passage level above 150 Hz — surface noise and hiss. Rumble and mains hum are excluded; see the HUM tile. Shown as — when the passage is too steady to have a separate floor."/>
                                    <TextBlock Text="{Binding NoiseFloorText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="L / R" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                                    <TextBlock Text="{Binding BalanceText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="DC OFFSET" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="DC riding on the programme; wastes headroom and suggests a cabling or interface fault"/>
                                    <TextBlock Text="{Binding DcText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DcText}" Value="OK">
                                                        <Setter Property="Foreground" Value="#73E6AE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DcText}" Value="—">
                                                        <Setter Property="Foreground" Value="#71817C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="HUM" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="Mains hum dominating the quiet passages; usually a turntable ground-lead issue"/>
                                    <TextBlock Text="{Binding HumText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HumText}" Value="NONE">
                                                        <Setter Property="Foreground" Value="#73E6AE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock></StackPanel>
                            </Border>
                            <Border Grid.Column="5" Background="#0F1715" BorderBrush="#293532" BorderThickness="1" CornerRadius="7" Padding="8" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="CLIPPING" FontSize="8" FontWeight="Bold" Foreground="#71817C"
                                                       ToolTip="Sustained digital rail hits warn; isolated stylus clicks are labeled but excluded from gain advice"/>
                                    <TextBlock Text="{Binding ClippingText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClippingText}" Value="NONE">
                                                        <Setter Property="Foreground" Value="#73E6AE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasOnlyIsolatedClipping}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock></StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="RECENT INPUT LEVEL" FontSize="8" FontWeight="Bold" Foreground="#71817C"/>
                            <TextBlock Text="30 s window" HorizontalAlignment="Right" FontSize="8" Foreground="#71817C"/>
                        </Grid>
                        <c:LevelHistoryGraph Margin="0,5,0,0" Height="46"
                                             Values="{Binding LevelHistory}"
                                             TargetMinimumDb="{Binding TargetMeterMinimumDb}"
                                             TargetMaximumDb="{Binding TargetMeterMaximumDb}"/>

                        <CheckBox x:Name="wholeRecordCheck" Margin="0,11,0,0"
                                  Content="Scan the whole song / record side"
                                  IsChecked="{Binding SampleWholeRecord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Play from lead-in through run-out; WaveLab holds the safest setting found anywhere on the side"
                                  AutomationProperties.Name="Scan the whole song or record side for recording level"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ProgressBar Height="5" Minimum="0" Maximum="100"
                                             Value="{Binding LevelConfidencePercent, Mode=OneWay}"
                                             Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="{Binding LevelProgressText}" Margin="0,5,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="#7F918C"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="resetLevelCheckBtn" Content="Reset Check"
                                    Width="94" Height="32" Margin="14,0,0,0" IsEnabled="False"
                                    Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                                    Click="OnResetLevelCheck"
                                    ToolTip="Clear active or frozen level-check measurements"/>
                            <Button Grid.Column="2" x:Name="levelCheckBtn" Content="{Binding LevelCheckButtonText}"
                                    Width="112" Height="32" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                                    Click="OnLevelCheck" ToolTip="Start or stop monitoring without keeping the calibration audio"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="AUTOMATIC START" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"
                           Margin="0,14,0,0"/>
                <Border Background="#101918" BorderBrush="#2D4742" BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,7,0,0">
                    <StackPanel>
                        <CheckBox x:Name="chkNeedleDrop" Content="Start when the needle touches the record"
                                  Checked="OnNeedleDropOptionChanged" Unchecked="OnNeedleDropOptionChanged"
                                  AutomationProperties.Name="Start recording on needle drop"/>
                        <TextBlock Text="Listens while armed, then keeps the contact click and 250 ms before it so the opening groove is never clipped."
                                   Margin="22,4,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="AUTOMATIC STOP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"
                           Margin="0,14,0,0"/>
                <Border Background="#101918" BorderBrush="#2D4742" BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,7,0,0">
                    <StackPanel>
                        <CheckBox x:Name="chkRunOutStop" Content="Stop when the side runs out"
                                  IsChecked="{Binding AutoStopOnRunOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="OnAutoStopOptionChanged" Unchecked="OnAutoStopOptionChanged"
                                  ToolTip="Listens for the run-out groove — surface noise with no music in it"
                                  AutomationProperties.Name="Stop recording at the run-out groove"/>
                        <TextBlock Text="Listens for surface noise with no music in it. Keeps 2 s past the last programme content and trims the rest."
                                   Margin="22,4,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"
                                   TextWrapping="Wrap"/>
                        <StackPanel x:Name="runOutHoldRow" Orientation="Horizontal" Margin="25,10,0,0">
                            <TextBlock Text="Wait" Foreground="#B7BEC6" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtRunOutHold" Width="52" Margin="9,0,0,0" Padding="8,5" FontSize="12"
                                     VerticalAlignment="Center" TextAlignment="Center"
                                     LostFocus="OnRunOutHoldChanged"
                                     ToolTip="5 to 60 seconds; 12 is long enough to sit through a gap between tracks"
                                     AutomationProperties.Name="Seconds of run-out to wait before stopping"/>
                            <TextBlock Text="s of run-out before stopping" Margin="9,0,0,0" Foreground="#B7BEC6"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="#1E332F" Margin="0,11,0,11"/>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="chkDurationStop" Content="Stop after" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStopOnDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="OnAutoStopOptionChanged" Unchecked="OnAutoStopOptionChanged"
                                      AutomationProperties.Name="Stop recording after a fixed length"/>
                            <TextBox x:Name="txtAutoStopMinutes" Width="56" Margin="9,0,0,0" Padding="8,5" FontSize="12"
                                     VerticalAlignment="Center" TextAlignment="Center"
                                     LostFocus="OnAutoStopMinutesChanged"
                                     ToolTip="1 to 180 minutes. A take also ends at WaveLab's in-memory limit — about 35 minutes at 48 kHz stereo, and proportionally less at higher rates."
                                     AutomationProperties.Name="Maximum take length in minutes"/>
                            <TextBlock Text="minutes" Margin="9,0,0,0" Foreground="#CDD3D9" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Safety limit — fires whether or not the run-out is ever detected."
                                   Margin="22,4,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="METRONOME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"
                           Margin="0,14,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chkCountIn" Content="Count-in" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBpm" Grid.Column="2" Text="120" Padding="8,5" FontSize="12" VerticalAlignment="Center"
                             AutomationProperties.Name="Metronome tempo in BPM"/>
                    <TextBlock Grid.Column="4" Text="BPM ·" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ComboBox x:Name="cmbBars" Width="86" Height="30" AutomationProperties.Name="Count-in bars"/>
                        <CheckBox x:Name="chkMetronome" Content="Click while recording" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkPunch" Content="Insert into selection on stop (punch)" Margin="0,12,0,0"
                          Visibility="Collapsed"/>
                <TextBlock x:Name="countInText" Text="COUNT-IN…" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Amber}" HorizontalAlignment="Center" Margin="0,9,0,0"
                           Visibility="Collapsed"/>
                <TextBlock Text="{Binding AutoStopStatusText}" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Amber}" HorizontalAlignment="Center" Margin="0,9,0,0"
                           Visibility="{Binding HasAutoStopStatus, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource MonoFont}" FontSize="28"
                           Foreground="{StaticResource Red}" HorizontalAlignment="Center" Margin="0,8,0,2"/>
            </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="cancelBtn" Content="Cancel" Height="38" Click="OnCancel"
                            Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"/>
                    <Button Grid.Column="2" x:Name="startBtn" Height="38" Click="OnStartStop"
                            Style="{StaticResource DangerButton}" AutomationProperties.Name="Start or stop recording">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="startText" Text="Start Recording" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
