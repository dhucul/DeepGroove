<Window x:Class="WaveLab.Views.RackValueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Effect Value" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">
    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <StackPanel>
            <TextBlock x:Name="titleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="hintText" Margin="0,10,0,12" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"/>
            <TextBox x:Name="valueInput" Padding="8" TextChanged="OnValueChanged"/>
            <TextBlock x:Name="previewText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="errorText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Amber}" Visibility="Collapsed"/>
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="Cancel" Height="35" Style="{StaticResource AccentButton}" IsCancel="True"/>
                <Button x:Name="applyBtn" Grid.Column="2" Content="Apply" Height="35"
                        Style="{StaticResource AccentButton}" IsDefault="True" Click="OnApply"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
