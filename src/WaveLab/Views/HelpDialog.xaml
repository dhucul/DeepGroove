<Window x:Class="WaveLab.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveLab Help" Icon="/WaveLab;component/Assets/wavelab.ico"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="12.5"
        UseLayoutRounding="True" KeyDown="OnWindowKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WaveLab Help" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Searchable guidance for recording, editing, restoration, mastering, and export"
                               Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="F1 HELP  ·  CTRL+F SEARCH  ·  ESC CLOSE"
                           VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                           FontSize="9" Foreground="{StaticResource Faint}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SEARCH HELP" Style="{StaticResource UpperLabel}"/>
                <TextBox x:Name="searchBox" Grid.Row="1" Margin="0,7,0,12" Padding="11,8"
                         ToolTip="Search topic titles and all help text (Ctrl+F)"
                         TextChanged="OnSearchChanged"/>
                <Grid Grid.Row="2">
                    <ListBox x:Name="topicList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTopicSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource UpperLabel}"/>
                                    <TextBlock Text="{Binding Title}" Margin="0,3,0,0" FontSize="12.5"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="noResults" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="No help topics found" FontSize="12.5" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Try fewer or broader words." Margin="0,5,0,0"
                                   Foreground="{StaticResource Muted}" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource Line}"/>

            <ScrollViewer x:Name="contentScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="34,28,28,34">
                <StackPanel x:Name="topicContent" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding Title}" Margin="0,7,0,0" FontSize="26"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Margin="0,9,0,0" FontSize="14"
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap" LineHeight="21"/>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,22,0,4"/>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,17,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Body}" Margin="0,7,0,0" FontSize="12.5"
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0">
                <TextBlock x:Name="resultCount" VerticalAlignment="Center" Foreground="{StaticResource Faint}"
                           FontSize="10.5"/>
                <Button DockPanel.Dock="Right" Content="Close" Width="82" Height="28"
                        VerticalAlignment="Center" Style="{StaticResource AccentButton}" Click="OnClose" IsCancel="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
