<Window x:Class="WaveLab.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="titleText" Text="Export" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="20,18">
                <TextBlock Text="FORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                <ComboBox x:Name="cmbFormat" Margin="0,6,0,14" SelectionChanged="OnFormatChanged"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BITRATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <ComboBox x:Name="cmbBitrate" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SAMPLE RATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <ComboBox x:Name="cmbRate" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="RANGE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,14,0,0"/>
                <ComboBox x:Name="cmbRange" Margin="0,6,0,0"/>

                <TextBlock x:Name="busyText" Margin="0,14,0,0" FontSize="11.5" Foreground="{StaticResource Accent}"
                           Text="Exporting…" Visibility="Collapsed"/>
            </StackPanel>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCancel" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Height="36" Click="OnCancel" Content="Cancel"/>
                    <Button x:Name="btnExport" Grid.Column="2" Style="{StaticResource AccentButton}" Height="36"
                            Click="OnExport" Content="Export…"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
