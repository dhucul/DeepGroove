<Window x:Class="WaveLab.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Groove" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Window.Resources>
        <!-- ToolButton is a 38x38 icon square, so the fixed width has to go or a labelled choice
             renders as two characters - the fault SegmentButton was created for. Height becomes
             MinHeight because these labels wrap: a choice cut mid-glyph reads as a drawing fault,
             and one on two lines reads as a choice. -->
        <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="PrimaryChoiceButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}"
            BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="22,20">
            <TextBlock x:Name="titleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="messageText" Margin="0,10,0,0" FontSize="12.5"
                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
            <!-- Stacked rather than in a row: these labels carry the figures the choice turns on,
                 so they are sentences rather than verbs, and a row of them is what runs a dialog
                 past its own width. -->
            <StackPanel x:Name="buttons" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
