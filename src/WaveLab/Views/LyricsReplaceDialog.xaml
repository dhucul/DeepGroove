<Window x:Class="WaveLab.Views.LyricsReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace words or phrases" Width="900" Height="660" MinWidth="740" MinHeight="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        FontSize="12.5" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style x:Key="PreviewText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="OnDragMove" Background="Transparent" Margin="0,0,0,14">
                <StackPanel Margin="0,0,35,0">
                    <TextBlock Text="Replace words or phrases" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="Correct any word or phrase, regardless of spelling. Review the changes below before applying."
                               TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="&#x00D7;" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CaptionCloseButton}" Click="OnClose"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="FIND — THE WORDS CURRENTLY IN THE TRANSCRIPT" Style="{StaticResource UpperLabel}"/>
                <TextBox x:Name="findText" Height="56" Margin="0,6,0,0" Padding="10,6" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged" AutomationProperties.Name="Find words or phrase"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="REPLACE WITH — YOUR CORRECTED WORDS" Style="{StaticResource UpperLabel}"/>
                <TextBox x:Name="replacementText" Height="64" Margin="0,6,0,0" Padding="10,6" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged" AutomationProperties.Name="Replacement words or phrase"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Apply to" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="scopeCombo" Width="180" SelectionChanged="OnScopeChanged" AutomationProperties.Name="Replacement scope">
                    <ComboBoxItem x:Name="selectedScope" Content="Selected line"/>
                    <ComboBoxItem Content="Whole transcript"/>
                </ComboBox>
                <CheckBox x:Name="matchCaseCheck" Content="Match case" Margin="20,0,0,0" VerticalAlignment="Center" Click="OnOptionChanged"/>
                <CheckBox x:Name="wholeWordsCheck" Content="Whole words" IsChecked="True" Margin="20,0,0,0" VerticalAlignment="Center" Click="OnOptionChanged"/>
            </StackPanel>
            <TextBlock x:Name="previewLabel" Grid.Row="4" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource Muted}"/>
            <DataGrid x:Name="previewGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0"
                      Background="{StaticResource Panel2}" BorderBrush="{StaticResource LineSoft}" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineSoft}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Replacement preview">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="105" ElementStyle="{StaticResource PreviewText}"/>
                    <DataGridTextColumn Header="BEFORE" Binding="{Binding Before}" Width="*" ElementStyle="{StaticResource PreviewText}"/>
                    <DataGridTextColumn Header="AFTER" Binding="{Binding AfterPreview}" Width="*" ElementStyle="{StaticResource PreviewText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="6" Margin="0,12,0,0">
                <TextBlock x:Name="statusLabel" Text="Line timings stay unchanged. Export the transcript to keep your corrections."
                           TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                <DockPanel>
                    <Button x:Name="undoButton" Content="Undo last replacement" Style="{StaticResource Action}" Click="OnUndo" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="applyButton" Content="Apply replacement" Style="{StaticResource Action}" Click="OnApply" Margin="0,0,10,0"/>
                        <Button Content="Close" Style="{StaticResource Action}" Click="OnClose" IsCancel="True" MinWidth="86"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
