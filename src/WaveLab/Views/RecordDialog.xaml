<Window x:Class="WaveLab.Views.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaveLab.Views.Controls"
        Title="Record Audio" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- header -->
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,16"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                    <TextBlock Text="Record Audio" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="20,18">
                <TextBlock Text="INPUT DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                <ComboBox x:Name="deviceCombo" Margin="0,6,0,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="FORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,14,0,0"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="12,9" Margin="0,6,0,0">
                    <TextBlock Text="{Binding FormatText}" Foreground="#CDD3D9" FontSize="12"/>
                </Border>

                <TextBlock Text="INPUT LEVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <c:LevelMeter Width="240" Height="14" PeakDb="{Binding PeakLDb}" RmsDb="-60" PeakHoldDb="-60"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <c:LevelMeter Width="240" Height="14" PeakDb="{Binding PeakRDb}" RmsDb="-60" PeakHoldDb="-60"/>
                </StackPanel>

                <TextBlock Text="METRONOME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,14,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chkCountIn" Content="Count-in" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBpm" Grid.Column="2" Text="120" Padding="8,5" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="BPM ·" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ComboBox x:Name="cmbBars" Width="86" Height="30"/>
                        <CheckBox x:Name="chkMetronome" Content="Click while recording" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkPunch" Content="Insert into selection on stop (punch)" Margin="0,12,0,0"
                          Visibility="Collapsed"/>

                <TextBlock x:Name="countInText" Text="COUNT-IN…" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Amber}" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="Collapsed"/>
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource MonoFont}" FontSize="30"
                           Foreground="{StaticResource Red}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
            </StackPanel>

            <!-- footer -->
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="cancelBtn" Content="Cancel" Height="38" Click="OnCancel" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}"/>
                    <Button Grid.Column="2" x:Name="startBtn" Height="38" Click="OnStartStop" Style="{StaticResource DangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="startText" Text="Start Recording" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
