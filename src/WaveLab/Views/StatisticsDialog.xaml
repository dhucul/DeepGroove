<Window x:Class="WaveLab.Views.StatisticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Statistics" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="titleText" Text="Audio Statistics" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid Margin="6,8" MinHeight="220">
                <TextBlock x:Name="busyText" Text="Analyzing…" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ItemsControl x:Name="rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#1A1F25" BorderThickness="0,0,0,1" Padding="14,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Left}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5" Foreground="{StaticResource Text}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Right}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5" Foreground="{StaticResource Text}" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <DockPanel>
                    <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="34" Width="90"
                            Click="OnCopy" Content="Copy" HorizontalAlignment="Left"/>
                    <Button Style="{StaticResource AccentButton}" Height="34" Width="90" Click="OnClose" IsCancel="True"
                            Content="Close" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
