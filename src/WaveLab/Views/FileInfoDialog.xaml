<Window x:Class="WaveLab.Views.FileInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Information" Width="560" Height="512" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">
    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,16"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="File Information" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="subtitleText" Margin="14,2,0,0" FontSize="10.5"
                               Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,16,20,0">
                <ToggleButton x:Name="descriptionTab" Style="{StaticResource SegmentButton}" Height="28"
                              Content="Description" IsChecked="True" Click="OnTabChanged"/>
                <ToggleButton x:Name="broadcastTab" Style="{StaticResource SegmentButton}" Height="28"
                              Margin="6,0,0,0" Content="Broadcast" Click="OnTabChanged"/>
                <ToggleButton x:Name="chunksTab" Style="{StaticResource SegmentButton}" Height="28"
                              Margin="6,0,0,0" Content="Chunks" Click="OnTabChanged"/>
            </StackPanel>

            <!-- Description -->
            <Grid x:Name="descriptionPage" Grid.Row="2" Margin="20,16,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="TITLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="titleBox" Margin="0,6,0,0" Padding="10,7"
                             AutomationProperties.Name="Title"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ARTIST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="artistBox" Margin="0,6,0,0" Padding="10,7"
                             AutomationProperties.Name="Artist"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="ALBUM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="albumBox" Margin="0,6,0,0" Padding="10,7"
                             AutomationProperties.Name="Album"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="TRACK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="trackBox" Margin="0,6,0,0" Padding="10,7" FontFamily="{StaticResource MonoFont}"
                             ToolTip="Either 3 or 3/12."/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="GENRE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="genreBox" Margin="0,6,0,0" Padding="10,7"
                             AutomationProperties.Name="Genre"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="YEAR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="yearBox" Margin="0,6,0,0" Padding="10,7" FontFamily="{StaticResource MonoFont}"
                             ToolTip="A year, or a fuller date as yyyy-MM-dd."/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="COMMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="commentBox" Margin="0,6,0,0" Padding="10,7" Height="72"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Comment"/>
                </StackPanel>
            </Grid>

            <!-- Broadcast -->
            <Grid x:Name="broadcastPage" Grid.Row="2" Margin="20,16,20,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="5">
                    <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="bextDescription" Margin="0,6,0,0" Padding="10,7" MaxLength="256"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="ORIGINATOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="bextOriginator" Margin="0,6,0,0" Padding="10,7" MaxLength="32"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                    <TextBlock Text="REFERENCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="bextReference" Margin="0,6,0,0" Padding="10,7" MaxLength="32"
                             ToolTip="An unambiguous reference to this take."/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="DATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="bextDate" Margin="0,6,0,0" Padding="10,7" MaxLength="10"
                             FontFamily="{StaticResource MonoFont}" ToolTip="yyyy-MM-dd"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="TIME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="bextTime" Margin="0,6,0,0" Padding="10,7" MaxLength="8"
                             FontFamily="{StaticResource MonoFont}" ToolTip="HH:mm:ss"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,12,0,0">
                    <TextBlock Text="TIME REFERENCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="bextTimeReference" Margin="0,6,0,0" Padding="10,7"
                             FontFamily="{StaticResource MonoFont}"
                             ToolTip="Samples since midnight to the first sample. 64-bit."/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <TextBlock Text="CODING HISTORY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="bextHistory" Margin="0,6,0,0" Padding="10,7" Height="60"
                             FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </StackPanel>

                <TextBlock x:Name="broadcastNote" Grid.Row="4" Grid.ColumnSpan="5" Margin="0,10,0,0"
                           FontSize="10.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
            </Grid>

            <!-- Chunks -->
            <Grid x:Name="chunksPage" Grid.Row="2" Margin="20,16,20,0" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}"
                        BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="14,10" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="ID" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Column="1" Text="SIZE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Column="2" Text="WHAT IT CARRIES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        </Grid>
                        <ListBox x:Name="chunkList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Border Padding="14,6" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#C3CAD2"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" Foreground="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Meaning}" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <TextBlock x:Name="chunkNote" Grid.Row="1" Margin="2,10,0,0" FontSize="10.5"
                           Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="statusText" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="cancelBtn" Content="Cancel" Height="38" Style="{StaticResource AccentButton}"
                                Foreground="{StaticResource Muted}" Click="OnCancel" IsCancel="True"/>
                        <Button x:Name="applyBtn" Grid.Column="2" Content="Apply" Height="38"
                                Style="{StaticResource AccentButton}" Click="OnApply" IsDefault="True"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
