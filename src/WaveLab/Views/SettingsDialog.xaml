<Window x:Class="WaveLab.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid MinHeight="360">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0" Padding="10">
                    <StackPanel>
                        <RadioButton x:Name="navGeneral" Content="General" IsChecked="True" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                        <RadioButton x:Name="navAudio" Content="Audio" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                        <RadioButton x:Name="navAutosave" Content="Autosave" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                        <RadioButton x:Name="navExport" Content="Export" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="22,18">
                    <!-- General -->
                    <StackPanel x:Name="pageGeneral">
                        <CheckBox x:Name="chkReopen" Content="Reopen last session files on start"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="UNDO HISTORY LIMIT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Slider x:Name="sldUndo" Width="220" Minimum="64" Maximum="4096" TickFrequency="64" IsSnapToTickEnabled="True"
                                    ValueChanged="OnUndoSliderChanged"/>
                            <TextBlock x:Name="lblUndo" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"
                                   Text="Oldest edits are discarded once history exceeds this memory budget."/>
                    </StackPanel>

                    <!-- Audio -->
                    <StackPanel x:Name="pageAudio" Visibility="Collapsed">
                        <TextBlock Text="OUTPUT DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <ComboBox x:Name="cmbOutput" Margin="0,6,0,14"/>
                        <TextBlock Text="DEFAULT INPUT DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <ComboBox x:Name="cmbInput" Margin="0,6,0,14"/>
                        <TextBlock Text="PLAYBACK BUFFER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Slider x:Name="sldBuffer" Width="220" Minimum="20" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                    ValueChanged="OnBufferSliderChanged"/>
                            <TextBlock x:Name="lblBuffer" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"
                                   Text="Smaller buffers reduce latency; larger buffers are safer on busy systems. Applies to the next playback."/>
                    </StackPanel>

                    <!-- Autosave -->
                    <StackPanel x:Name="pageAutosave" Visibility="Collapsed">
                        <CheckBox x:Name="chkAutosave" Content="Autosave modified files for crash recovery"/>
                        <TextBlock Text="INTERVAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,16,0,0"/>
                        <ComboBox x:Name="cmbAutosaveInterval" Margin="0,6,0,0" Width="180" HorizontalAlignment="Left"/>
                        <TextBlock Margin="0,10,0,0" FontSize="10.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                   Text="Copies of unsaved work are kept in your user profile and offered for recovery if WaveLab doesn't shut down cleanly. They are removed on normal exit."/>
                    </StackPanel>

                    <!-- Export -->
                    <StackPanel x:Name="pageExport" Visibility="Collapsed">
                        <TextBlock Text="DEFAULT FORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <ComboBox x:Name="cmbExportFormat" Margin="0,6,0,14" Width="300" HorizontalAlignment="Left"
                                  SelectionChanged="OnExportFormatChanged"/>
                        <StackPanel x:Name="exportBitratePanel">
                            <TextBlock Text="DEFAULT BITRATE (LOSSY)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                            <ComboBox x:Name="cmbExportBitrate" Margin="0,6,0,0" Width="160" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="16,13">
                <DockPanel>
                    <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="34" Padding="14,0"
                            Click="OnRestoreDefaults" Content="↺ Restore Defaults" HorizontalAlignment="Left"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="34" Width="90" Click="OnCancel" Content="Cancel"/>
                        <Button Style="{StaticResource AccentButton}" Height="34" Width="90" Margin="10,0,0,0" Click="OnSave" Content="Save"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
