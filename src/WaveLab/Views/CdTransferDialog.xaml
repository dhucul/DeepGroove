<Window x:Class="WaveLab.Views.CdTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepare Audio CD" Width="790" Height="660" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">
    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,16"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Amber}" VerticalAlignment="Center"/>
                    <TextBlock Text="Prepare Audio CD" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="regions → ordered tracks → 44.1 kHz / 16-bit WAV + CUE"
                               Margin="14,2,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20,15,20,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DISC TITLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="discTitle" Margin="0,6,0,0" Padding="10,7" TextChanged="OnPlanChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TARGET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    <Border Margin="0,6,0,0" Height="36" Padding="10,0" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="Audio CD · 80 min · 99 tracks max" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="20,0,20,10" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/><ColumnDefinition Width="10"/><ColumnDefinition Width="112"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AUTO SPLIT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Quiet below" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="thresholdSlider" Width="150" Minimum="-70" Maximum="-25" Value="-45" ValueChanged="OnThresholdChanged"/>
                        <TextBlock x:Name="thresholdText" Width="52" Margin="8,0,0,0" Text="−45 dB" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="analyzeBtn" Grid.Column="3" Content="Analyze" Height="32" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}" Click="OnAutoSplit"/>
                    <Button x:Name="addSelectionBtn" Grid.Column="5" Content="Use Selection" Height="32" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}" Click="OnAddSelection"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="20,0,20,10" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="14,10" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                        <TextBlock Text="ORDER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <TextBlock Grid.Column="1" Text="TITLE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <TextBlock Grid.Column="2" Text="SOURCE IN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                        <TextBlock Grid.Column="3" Text="SOURCE OUT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                    </Grid>
                    <ListBox x:Name="trackList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnTrackSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="row" Padding="14,7" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Panel3}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#21312F"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OrderText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" Margin="0,0,14,0"/>
                            <TextBox x:Name="startEditor" Grid.Column="2" Text="{Binding StartText, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}" Padding="5,4" Margin="0,0,6,0"
                                     ToolTip="Seconds, mm:ss, or hh:mm:ss.mmm" LostFocus="OnRangeEditCommitted"/>
                            <TextBox x:Name="endEditor" Grid.Column="3" Text="{Binding EndText, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}" Padding="5,4"
                                     ToolTip="Seconds, mm:ss, or hh:mm:ss.mmm" LostFocus="OnRangeEditCommitted"/>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="20,0,20,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="upBtn" Content="▲" Width="34" Height="30" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnMoveUp"/>
                    <Button x:Name="downBtn" Content="▼" Width="34" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnMoveDown"/>
                    <Button x:Name="removeBtn" Content="Remove" Width="72" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnRemove"/>
                    <Button x:Name="splitBtn" Content="Split" Width="54" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}"
                            Foreground="{StaticResource Muted}" ToolTip="Split at the document cursor, or at the midpoint" Click="OnSplitSelected"/>
                    <Button x:Name="saveRegionsBtn" Content="Sync Regions" Width="100" Height="30" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnSaveRegions"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,-2" VerticalAlignment="Center">
                    <TextBlock x:Name="validationText" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Muted}" FontSize="10.5"/>
                    <CheckBox x:Name="renderRackCheck" Margin="0,5,0,0" Content="Render the current rack into Preview and exported files"
                              Foreground="{StaticResource Muted}" Checked="OnRenderRackChanged" Unchecked="OnRenderRackChanged"
                              ToolTip="When off, both Preview and export use the unprocessed source."/>
                </StackPanel>
                <Button x:Name="previewBtn" Grid.Column="2" Content="▶ Preview Track" Width="124" Height="30"
                        Style="{StaticResource AccentButton}" Click="OnPreview"/>
            </Grid>

            <Border Grid.Row="5" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <ProgressBar x:Name="progressBar" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource Accent}"
                                     Background="{StaticResource Panel3}"/>
                        <TextBlock x:Name="statusText" Text="Arrange the proposed tracks, then export a burner-ready package."
                                   Margin="0,7,0,0" FontSize="10.5" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="closeBtn" Content="Close" Height="38" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnClose"/>
                        <Button x:Name="exportBtn" Grid.Column="2" Content="Export CD Package…" Height="38" Style="{StaticResource AccentButton}" Click="OnExport"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
