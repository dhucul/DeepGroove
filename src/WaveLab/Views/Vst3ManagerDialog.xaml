<Window x:Class="WaveLab.Views.Vst3ManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VST3 Plugins" Width="920" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── title ── -->
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Violet}" VerticalAlignment="Center"/>
                        <TextBlock Text="VST3 Plugins" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" Width="24" Height="22" FontSize="11" HorizontalAlignment="Right"
                            Style="{StaticResource ToolButton}" Foreground="{StaticResource Muted}"
                            Click="OnClose" AutomationProperties.Name="Close"/>
                </Grid>
            </Border>

            <!-- ── scan folders ── -->
            <StackPanel Grid.Row="1" Margin="18,14,18,0">
                <TextBlock Text="SCAN FOLDERS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Faint}"/>
                <Border Background="{StaticResource WellDeep}" BorderBrush="{StaticResource LineSoft}"
                        BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="9,7">
                    <StackPanel>
                        <ItemsControl x:Name="folderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1.5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Foreground="{Binding PathBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="9.5"
                                                   Foreground="{StaticResource Faint}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="✕" Width="18" Height="18" FontSize="9"
                                                Margin="8,0,0,0" Style="{StaticResource MiniButton}"
                                                Click="OnRemoveFolder" Tag="{Binding Path}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Stop scanning this folder"
                                                AutomationProperties.Name="Remove scan folder"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋  Add folder…" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Style="{StaticResource MiniButton}" FontSize="10.5" Padding="0,2"
                                Click="OnAddFolder" AutomationProperties.Name="Add scan folder"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── controls ── -->
            <Grid Grid.Row="2" Margin="18,12,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="rescanButton" Style="{StaticResource AccentButton}" Height="29" Padding="14,0"
                        Content="⟳  Rescan everything" Click="OnRescanAll"
                        AutomationProperties.Name="Rescan every plugin"/>
                <Button x:Name="rescanChangedButton" Grid.Column="1" Style="{StaticResource AccentButton}"
                        Foreground="{StaticResource Muted}" Height="29" Padding="12,0" Margin="7,0,0,0"
                        Content="Rescan changed only" Click="OnRescanChanged"
                        ToolTip="Skips every plugin whose binary has not changed since it was last scanned"
                        AutomationProperties.Name="Rescan changed plugins only"/>
                <Grid Grid.Column="2" Margin="10,0">
                    <TextBox x:Name="filterBox" Height="29" VerticalContentAlignment="Center"
                             TextChanged="OnFilterChanged" AutomationProperties.Name="Filter plugins"
                             ToolTip="Filter by name or vendor"/>
                    <TextBlock x:Name="filterHint" Text="Filter by name or vendor…" IsHitTestVisible="False"
                               Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource Faint}"/>
                </Grid>
                <CheckBox x:Name="showFailed" Grid.Column="3" Content="Show rejected" VerticalAlignment="Center"
                          FontSize="11" IsChecked="True" Click="OnFilterChanged"
                          AutomationProperties.Name="Show rejected plugins"/>
            </Grid>

            <!-- ── the table ── -->
            <Border Grid.Row="3" Margin="18,12,18,0" Background="{StaticResource WellDeep}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Panel3}" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="10,0" Height="26">
                        <Grid TextBlock.FontSize="8.5" TextBlock.FontWeight="Bold"
                              TextBlock.Foreground="{StaticResource Faint}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="PLUGIN" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="VENDOR" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="CATEGORY" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="I/O" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="5" Text="PARAMS" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="6" Text="STATUS" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="list" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,2"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged"
                             AutomationProperties.Name="Scanned plugins">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" Padding="10,0" Height="30">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#132B28"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel3}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid TextBlock.FontSize="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding Allowed, Mode=TwoWay}" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsUsable}" Click="OnAllowedChanged"
                                              ToolTip="Offer this plugin in the Add Effect menu"
                                              AutomationProperties.Name="Offer this plugin"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding NameBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Vendor}" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Category}" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding ChannelsText}" FontSize="10"
                                               FontFamily="{StaticResource MonoFont}" Foreground="#9AA1A9"
                                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="5" Text="{Binding ParametersText}" FontSize="10"
                                               FontFamily="{StaticResource MonoFont}" Foreground="#9AA1A9"
                                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <Border Grid.Column="6" Background="{Binding StatusBackground}" CornerRadius="3"
                                            Padding="6,1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{Binding StatusForeground}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── the selected plugin ── -->
            <Border Grid.Row="4" Margin="18,10,18,0" Background="{StaticResource Panel3}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="6" Padding="11,9">
                <StackPanel>
                    <TextBlock x:Name="detailPath" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="detailFacts" Margin="0,5,0,0" FontSize="10.5"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="detailMessage" Margin="0,5,0,0" FontSize="10.5"
                               Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ── footer ── -->
            <Border Grid.Row="5" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                    Padding="18,11" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="statusText" FontSize="10.5" Foreground="{StaticResource Faint}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Height="31" Padding="12,0" Margin="8,0,0,0" Content="Forget selected"
                            Click="OnForget" ToolTip="Scan this plugin again next time"
                            AutomationProperties.Name="Forget selected plugin"/>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                            Height="31" Padding="12,0" Margin="7,0,0,0" Content="Open folder"
                            Click="OnOpenFolder" AutomationProperties.Name="Open containing folder"/>
                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Height="31" Padding="18,0"
                            Margin="7,0,0,0" Content="Close" Click="OnClose"
                            AutomationProperties.Name="Close"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
