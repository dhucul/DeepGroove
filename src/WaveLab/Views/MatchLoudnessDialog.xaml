<Window x:Class="WaveLab.Views.MatchLoudnessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match Loudness" Width="1000" Height="700" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False"
        Closing="OnWindowClosing">

    <Window.Resources>
        <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource UpperLabel}">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="10" Opacity="0.65" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentWell}"
                                BorderBrush="{StaticResource AccentEdge}" BorderThickness="1">
                            <TextBlock Text="&#x2261;" Foreground="{StaticResource Accent}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0">
                            <TextBlock Text="Match Loudness" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Bring open tabs to a common programme loudness · gain only, never limiting"
                                       Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x00D7;" Style="{StaticResource CaptionCloseButton}"
                            FontSize="18" Height="34" Click="OnClose"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,14,20,0">
                <Grid x:Name="controlStrip">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Wider than its neighbours: the target line carries a name, a loudness and
                             a ceiling, and an even third clipped the last two characters off it. -->
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="MATCH TO" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="modeCombo" Margin="0,7,0,0" SelectedIndex="0"
                                  AutomationProperties.Name="What to match the tracks to"
                                  SelectionChanged="OnPlanInputChanged">
                            <ComboBoxItem Content="A preset delivery target"/>
                            <ComboBoxItem Content="The quietest track"/>
                            <ComboBoxItem Content="The average of the selection"/>
                            <ComboBoxItem Content="A reference track"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="TARGET" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="targetCombo" Margin="0,7,0,0"
                                  AutomationProperties.Name="Delivery target"
                                  SelectionChanged="OnPlanInputChanged"/>
                        <TextBlock x:Name="targetHint" Margin="0,5,0,0" FontSize="10.5"
                                   Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="REFERENCE" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="referenceCombo" Margin="0,7,0,0" DisplayMemberPath="Title"
                                  AutomationProperties.Name="Reference track"
                                  SelectionChanged="OnPlanInputChanged"/>
                        <TextBlock x:Name="referenceHint" Margin="0,5,0,0" FontSize="10.5"
                                   Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="34,16,32,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="TRACK" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="MEASURED" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="TRUE PEAK" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="GAIN" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="RESULT" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="NOTE" Style="{StaticResource ColumnHeader}" Margin="14,0,0,0"/>
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="20,0,12,0">
                <ItemsControl x:Name="trackItems" Margin="0,0,8,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="13,11" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Include this track"
                                              Checked="OnTrackTicked" Unchecked="OnTrackTicked"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MeasuredText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TruePeakText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding GainText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="{Binding ResultText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Note}" Margin="14,0,0,0"
                                               VerticalAlignment="Center" FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{Binding NoteBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="4" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="statusText" Text="Tick the tracks to level, then measure."
                                   Foreground="{StaticResource Muted}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="progressBar" Minimum="0" Maximum="1" Value="0" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="measureBtn" Content="Measure" Width="94" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryAction}" Click="OnMeasure"/>
                        <Button x:Name="copyBtn" Content="Copy Report" Width="108" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryAction}" Click="OnCopy"/>
                        <Button x:Name="applyBtn" Content="Apply Gain" Width="108" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryAction}" Click="OnApply"/>
                        <Button x:Name="closeBtn" Content="Close" Width="82" IsCancel="True"
                                Style="{StaticResource SecondaryAction}" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
