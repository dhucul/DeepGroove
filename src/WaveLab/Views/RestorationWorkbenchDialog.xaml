<Window x:Class="WaveLab.Views.RestorationWorkbenchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vinyl Transfer Workflow" Width="1000" Height="800" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False"
        Closing="OnWindowClosing">

    <Window.Resources>
        <Style x:Key="ValueReadout" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Height" Value="31"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="10" Opacity="0.65" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentWell}"
                                BorderBrush="{StaticResource AccentEdge}" BorderThickness="1">
                            <TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0">
                            <TextBlock Text="Vinyl Transfer Workflow" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Source-aware restoration · disc equalisation · one-step undo"
                                       Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Style="{StaticResource CaptionCloseButton}"
                            FontSize="18" Height="34" Click="OnClose"/>
                </Grid>
            </Border>

            <!-- source and preset strip -->
            <Grid Grid.Row="1" Margin="20,13,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="APPLY RANGE" Style="{StaticResource UpperLabel}"/>
                    <!-- A Grid rather than a horizontal StackPanel: the workbench is modeless, so the
                         recording and the selection it measured can both move underneath it, and the
                         sentence saying which has to give way to the button that fixes it rather than
                         push it off the strip. Saying it beside the range the analysis describes is
                         why it sits here and not in the action row. -->
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="rangeText" Text="Preparing selection…" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="formatText" Grid.Column="1" Margin="12,0,0,0"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="staleText" Grid.Column="2" Margin="12,0,6,0" Foreground="{StaticResource Amber}"
                                   FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                        <Button x:Name="reanalyzeBtn" Grid.Column="3" Content="Re-analyze" Width="88"
                                Style="{StaticResource SmallAction}" Foreground="{StaticResource Muted}"
                                Visibility="Collapsed" Click="OnReanalyze"
                                ToolTip="Scan the current audio and selection again, re-tuning every control from what it finds"/>
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="SOURCE SIGNAL" Style="{StaticResource UpperLabel}"/>
                    <ComboBox x:Name="sourceModeCombo" Grid.Row="2" Height="33" SelectedIndex="0"
                              SelectionChanged="OnSourceModeChanged">
                        <ComboBoxItem Content="RIAA already applied"/>
                        <ComboBoxItem Content="Flat cartridge transfer"/>
                    </ComboBox>
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="RESTORATION PRESET" Style="{StaticResource UpperLabel}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="presetCombo" Grid.Column="2" Height="33" SelectedIndex="1"
                              SelectionChanged="OnPresetChanged">
                        <ComboBoxItem Content="Gentle"/>
                        <ComboBoxItem Content="Balanced"/>
                        <ComboBoxItem Content="Strong"/>
                        <ComboBoxItem Content="Custom"/>
                        <ComboBoxItem Content="Analyzed"/>
                    </ComboBox>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="20,0,12,0">
                <StackPanel x:Name="controlsHost" Margin="0,0,8,14" IsEnabled="False">
                    <!-- Rail- and coordinate-dependent event repair runs first. These controls then
                         establish the channel geometry and time base used by the remaining stages. -->
                    <Border x:Name="preparationCard" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="5" Text="TRANSFER ALIGNMENT · APPLIED AFTER EVENT REPAIR"
                                       Style="{StaticResource UpperLabel}"/>
                            <StackPanel Grid.Row="2">
                                <CheckBox x:Name="removeDcEnabled" Content="Remove DC offset" IsChecked="True"
                                          Checked="OnPreparationChanged" Unchecked="OnPreparationChanged"/>
                                <TextBlock Text="Subtracts measured channel bias after rail-dependent peak repair."
                                           Style="{StaticResource CardCaption}"/>
                            </StackPanel>
                            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource LineSoft}" Margin="14,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <CheckBox x:Name="azimuthEnabled" Content="Correct stylus azimuth" IsChecked="False"
                                          Checked="OnPreparationChanged" Unchecked="OnPreparationChanged"/>
                                <TextBlock x:Name="azimuthEvidenceText" Text="Run analysis to measure channel timing."
                                           Style="{StaticResource CardCaption}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Row="2" Grid.Column="3" Background="{StaticResource LineSoft}" Margin="14,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <CheckBox x:Name="wowEnabled" Content="Correct wow &amp; flutter" IsChecked="False"
                                          Checked="OnPreparationChanged" Unchecked="OnPreparationChanged"/>
                                <TextBlock x:Name="wowEvidenceText" Text="Run analysis to measure time-base variation."
                                           Style="{StaticResource CardCaption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- analysis overview -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FULL-FILE IMPULSES" Style="{StaticResource UpperLabel}"/>
                                <TextBlock x:Name="clickCountText" Text="Run analysis to scan clicks and pops" Margin="0,5,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource LineSoft}" Margin="14,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FULL-FILE CLIPPING" Style="{StaticResource UpperLabel}"/>
                                <TextBlock x:Name="clipCountText" Text="Run analysis to scan distorted peaks" Margin="0,5,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="3" Background="{StaticResource LineSoft}" Margin="14,0"/>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="NOISE PRINT" Style="{StaticResource UpperLabel}"/>
                                <TextBlock x:Name="noiseSourceText" Text="Run analysis to find a noise print" Margin="0,5,0,0"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="preStageLabel" Grid.ColumnSpan="3" Text="REPAIR BEFORE DISC EQUALISATION"
                                   Style="{StaticResource UpperLabel}"/>

                        <!-- click / pop repair -->
                        <Border x:Name="clickCard" Grid.Row="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Click &amp; Pop Repair" FontSize="14" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="clickEnabled" HorizontalAlignment="Right" IsChecked="True"
                                              Content="Enabled" Checked="OnToolChanged" Unchecked="OnToolChanged"/>
                                </Grid>
                                <TextBlock Text="Signal-adaptive interpolation protects sustained musical attacks."
                                           Style="{StaticResource CardCaption}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Detection sensitivity" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="clickSensitivityText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="clickSensitivity" Minimum="1" Maximum="10" Value="6" TickFrequency="1"
                                        ValueChanged="OnParameterChanged"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Repair strength" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="clickStrengthText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="clickStrength" Minimum="0" Maximum="100" Value="75"
                                        ValueChanged="OnParameterChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- declip -->
                        <Border x:Name="declipCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Declip Distorted Peaks" FontSize="14" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="declipEnabled" HorizontalAlignment="Right" IsChecked="True"
                                              Content="Enabled" Checked="OnToolChanged" Unchecked="OnToolChanged"/>
                                </Grid>
                                <TextBlock Text="Rebuilds peaks that clipping flattened, from the audio that survived."
                                           Style="{StaticResource CardCaption}" Margin="0,5,0,10"/>
                                <TextBlock Text="METHOD" Style="{StaticResource UpperLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <ToggleButton x:Name="declipAuto" Style="{StaticResource SegmentButton}"
                                                  Content="Automatic" IsChecked="True" Click="OnDeclipMethodChanged"
                                                  ToolTip="Chooses per channel from how much is clipped and how sparse the material is. Neither method wins everywhere."/>
                                    <ToggleButton x:Name="declipSparse" Style="{StaticResource SegmentButton}"
                                                  Content="Sparse" Margin="4,0,0,0" Click="OnDeclipMethodChanged"
                                                  ToolTip="A-SPADE. Reconstructs the waveform from a sparse model. Much better while enough clean samples survive, and around 700× slower."/>
                                    <ToggleButton x:Name="declipPeaks" Style="{StaticResource SegmentButton}"
                                                  Content="Peaks" Margin="4,0,0,0" Click="OnDeclipMethodChanged"
                                                  ToolTip="Draws an arch between the clean shoulders either side of each flat top. Degrades gracefully, so it wins on heavily crushed material."/>
                                </StackPanel>
                                <TextBlock x:Name="declipMethodText" Margin="0,7,0,12" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                           Text="Run analysis to see the choice."/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Reconstruction strength" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="declipStrengthText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="declipStrength" Minimum="0" Maximum="100" Value="70"
                                        ValueChanged="OnParameterChanged"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Maximum reconstruction" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="declipHeadroomText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="declipHeadroom" Minimum="1" Maximum="12" Value="6" TickFrequency="1"
                                        ValueChanged="OnParameterChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- surface crackle remains before the disc curve so impulses stay sharp. -->
                        <Border x:Name="crackleCard" Grid.Row="4" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Surface Crackle" FontSize="14" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="decrackleEnabled" HorizontalAlignment="Right" IsChecked="False"
                                              Content="Enabled" Checked="OnToolChanged" Unchecked="OnToolChanged"/>
                                </Grid>
                                <TextBlock Text="The dense population of tiny defects below the click detector's reach, found on the prediction residual because music is predictable and dirt is not."
                                           Style="{StaticResource CardCaption}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Detection threshold" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="decrackleThresholdText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="decrackleThreshold" Minimum="2" Maximum="8" Value="3.5"
                                        ValueChanged="OnParameterChanged"/>
                                <TextBlock x:Name="decrackleEvidenceText" Margin="0,8,0,0" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- A flat transfer crosses this boundary exactly once. Cleanup analysis is
                             performed in the same post-curve domain that the stages below receive. -->
                        <Border x:Name="curveCard" Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DISC EQUALISATION BOUNDARY" Style="{StaticResource UpperLabel}"/>
                                    <TextBlock x:Name="curveSummaryText" Text="The source is already equalised; no disc curve will be applied."
                                               Margin="0,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="curveCombo" Grid.Column="2" Height="32" SelectedIndex="0"
                                          SelectionChanged="OnCurveChanged"/>
                                <ComboBox x:Name="curvePhaseCombo" Grid.Column="4" Height="32" SelectedIndex="0"
                                          SelectionChanged="OnCurveChanged">
                                    <ComboBoxItem Content="Minimum phase"/>
                                    <ComboBoxItem Content="Linear phase"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="postStageLabel" Grid.Row="8" Grid.ColumnSpan="3" Text="CLEANUP AFTER DISC EQUALISATION"
                                   Style="{StaticResource UpperLabel}"/>

                        <!-- noise / hiss -->
                        <Border x:Name="noiseCard" Grid.Row="10" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Noise &amp; Hiss Reduction" FontSize="14" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="noiseEnabled" HorizontalAlignment="Right" IsChecked="True"
                                              Content="Enabled" Checked="OnToolChanged" Unchecked="OnToolChanged"/>
                                </Grid>
                                <TextBlock Text="A smoothed spectral gate follows the learned surface-noise profile."
                                           Style="{StaticResource CardCaption}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Maximum reduction" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="noiseReductionText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="noiseReduction" Minimum="0" Maximum="24" Value="10"
                                        ValueChanged="OnParameterChanged"/>
                                <TextBlock x:Name="noiseDepthText" Margin="0,8,0,0" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="noiseDepthLead"/><Run x:Name="noiseDepthDetail"/>
                                </TextBlock>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Profile sensitivity" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="noiseSensitivityText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="noiseSensitivity" Minimum="0" Maximum="12" Value="5"
                                        ValueChanged="OnParameterChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- hum -->
                        <Border x:Name="humCard" Grid.Row="10" Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Hum Removal" FontSize="14" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="humEnabled" HorizontalAlignment="Right" IsChecked="False"
                                              Content="Enabled" Checked="OnToolChanged" Unchecked="OnToolChanged"/>
                                </Grid>
                                <TextBlock Text="Matched, narrow notches remove mains hum without shifting stereo alignment."
                                           Style="{StaticResource CardCaption}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="MAINS" Style="{StaticResource UpperLabel}"/>
                                        <ComboBox x:Name="humFrequency" Height="32" Margin="0,5,0,0" SelectedIndex="1"
                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                  SelectionChanged="OnToolChanged">
                                            <ComboBoxItem Content="50 Hz"/><ComboBoxItem Content="60 Hz"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Harmonics" Foreground="{StaticResource Muted}"/>
                                            <TextBlock x:Name="humHarmonicsText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                        </Grid>
                                        <Slider x:Name="humHarmonics" Minimum="1" Maximum="8" Value="4" TickFrequency="1"
                                                IsSnapToTickEnabled="True" ValueChanged="OnParameterChanged"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Removal strength" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="humStrengthText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="humStrength" Minimum="0" Maximum="100" Value="65"
                                        ValueChanged="OnParameterChanged"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Notch Q (higher is narrower)" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="humQText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="humQ" Minimum="8" Maximum="60" Value="35"
                                        ValueChanged="OnParameterChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- subsonic rumble -->
                        <Border x:Name="subsonicCard" Grid.Row="12" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Subsonic Rumble" FontSize="14" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="subsonicEnabled" HorizontalAlignment="Right" IsChecked="False"
                                              Content="Enabled" Checked="OnToolChanged" Unchecked="OnToolChanged"/>
                                </Grid>
                                <TextBlock Text="A phase-neutral Butterworth high-pass removes persistent warp and arm resonance below the music without putting phase-shifted music in the removed tab."
                                           Style="{StaticResource CardCaption}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Cutoff" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="subsonicCutoffText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="subsonicCutoff" Minimum="20" Maximum="60" Value="30"
                                        ValueChanged="OnParameterChanged"/>
                                <TextBlock x:Name="subsonicEvidenceText" Margin="0,8,0,0" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- vertical surface noise -->
                        <Border x:Name="verticalCard" Grid.Row="12" Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Vertical Surface Noise" FontSize="14" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="verticalEnabled" HorizontalAlignment="Right" IsChecked="False"
                                              Content="Enabled" Checked="OnToolChanged" Unchecked="OnToolChanged"/>
                                </Grid>
                                <TextBlock Text="Groove noise is mostly out of phase, so it lives in the side signal. This turns the whole side down, not noise alone; it suits mono or narrow pressings and can remove stereo music."
                                           Style="{StaticResource CardCaption}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Side level" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="sideLevelText" Grid.Column="1" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="sideLevel" Minimum="0" Maximum="100" Value="100"
                                        ValueChanged="OnParameterChanged"/>
                                <TextBlock x:Name="sideEvidenceText" Margin="0,8,0,0" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- audition / output -->
                    <Border x:Name="outputCard" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="15,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="OUTPUT MIX" Style="{StaticResource UpperLabel}"/>
                                <TextBlock x:Name="mixCaptionText" Text="Sample-aligned dry / restored" Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="14,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="Dry" Foreground="{StaticResource Faint}"/>
                                    <TextBlock x:Name="mixText" Text="100% restored" Style="{StaticResource ValueReadout}"/>
                                </Grid>
                                <Slider x:Name="globalMix" Grid.Row="1" Minimum="0" Maximum="100" Value="100"
                                        ValueChanged="OnParameterChanged"/>
                                <!-- The blend is applied once to the whole chain output, so the dry
                                     share it returns is a ceiling on every stage below. Saying so is
                                     the only way a stage that measures 40 dB on its own and lands at
                                     19.7 reads as the mix rather than as a broken tool. -->
                                <TextBlock x:Name="mixCeilingText" Grid.Row="2" Margin="0,9,0,0" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="mixCeilingLead"/><Run x:Name="mixCeilingDetail"/>
                                </TextBlock>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="AUDITION CHANNEL" Style="{StaticResource UpperLabel}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="auditionChannelCombo" Grid.Column="1" Width="128" Height="28"
                                              HorizontalAlignment="Right" SelectedIndex="0"
                                              SelectionChanged="OnAuditionChannelChanged">
                                        <ComboBoxItem Content="Stereo"/>
                                        <ComboBoxItem Content="Left only"/>
                                        <ComboBoxItem Content="Right only"/>
                                    </ComboBox>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <CheckBox x:Name="bypassCheck" Content="Bypass (dry)" Margin="0,0,16,0"
                                              Checked="OnBypassChanged" Unchecked="OnBypassChanged"/>
                                    <CheckBox x:Name="livePreviewCheck" Content="Live preview" IsChecked="True"
                                              Checked="OnLivePreviewChanged" Unchecked="OnLivePreviewChanged"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Its own full-width row rather than a third checkbox beside the other
                                 two: the caption carries a memory figure, and a figure nobody can
                                 read before ticking the box is not worth printing. -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                <CheckBox x:Name="keepRemovedCheck" Content="Keep what was removed"
                                          Checked="OnKeepRemovedChanged" Unchecked="OnKeepRemovedChanged"/>
                                <TextBlock x:Name="keepRemovedCaption" Style="{StaticResource CardCaption}"
                                           Text="Opens what was removed in a second tab so you can hear it."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- progress and actions -->
            <Border Grid.Row="3" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <ProgressBar x:Name="progressBar" Minimum="0" Maximum="1" Value="0"/>
                        <TextBlock x:Name="statusText" Text="Confirm the source signal, then press Analyze." Margin="0,7,0,0"
                                   Foreground="{StaticResource Faint}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="closeBtn" Content="Close" Width="72" Height="38"
                                Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Click="OnClose"/>
                        <Button x:Name="analyzeBtn" Content="Analyze" Width="92" Height="38" Margin="8,0,0,0"
                                Style="{StaticResource AccentButton}" Click="OnAnalyze"/>
                        <Button x:Name="previewBtn" Content="▶ Audition 12 s" Width="124" Height="38" Margin="8,0,0,0"
                                Style="{StaticResource AccentButton}" Click="OnPreview" IsEnabled="False"/>
                        <Button x:Name="applyBtn" Content="Apply" Width="82" Height="38" Margin="8,0,0,0"
                                Style="{StaticResource AccentButton}" Click="OnApply" IsEnabled="False"/>
                        <Button x:Name="applyCdBtn" Content="Apply &amp; Prepare CD" Width="154" Height="38" Margin="8,0,0,0"
                                Style="{StaticResource AccentButton}" Click="OnApplyAndPrepare" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
