<Window x:Class="WaveLab.Views.LyricsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrics &amp; Speech" Width="1080" Height="800" MinWidth="920" MinHeight="740"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        FontSize="12.5" ShowInTaskbar="False" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentWell}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="OnDragMove" Background="Transparent" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Lyrics &amp; Speech" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="sourceLabel" Foreground="{StaticResource Muted}" Margin="0,5,40,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Content="&#x00D7;" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CaptionCloseButton}" Click="OnClose"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="PRIVATE, ON YOUR PC" Style="{StaticResource UpperLabel}"/>
                        <TextBlock x:Name="engineLabel" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Vocal isolation and transcription run on your PC. No account, setup, or Internet connection is needed. CPU processing can take longer than the song."
                                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Grid x:Name="optionsPanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="AUDIO" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="modeCombo" SelectedIndex="0" Margin="0,6,0,0" AutomationProperties.Name="Audio type" SelectionChanged="OnModeChanged">
                            <ComboBoxItem Content="Music · isolate vocals"/>
                            <ComboBoxItem Content="Music · original mix"/>
                            <ComboBoxItem Content="Speech"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="QUALITY" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="qualityCombo" SelectedIndex="0" Margin="0,6,0,0" AutomationProperties.Name="Transcription quality">
                            <ComboBoxItem Content="Accuracy · large-v3"/>
                            <ComboBoxItem Content="Speed · turbo"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="LANGUAGE" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="languageCombo" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="Code" AutomationProperties.Name="Song language"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="PROCESSOR" Style="{StaticResource UpperLabel}"/>
                        <ComboBox x:Name="deviceCombo" SelectedIndex="0" Margin="0,6,0,0" AutomationProperties.Name="Processor">
                            <ComboBoxItem Content="Automatic · GPU / CPU"/>
                            <ComboBoxItem Content="CPU only"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid x:Name="hintsPanel" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="SPELLING HINTS (OPTIONAL)" Style="{StaticResource UpperLabel}"/>
                        <TextBox x:Name="hintsText" MaxLength="500" Height="30" Padding="10,2" Margin="0,6,0,0" VerticalContentAlignment="Center"
                                 TextChanged="OnHintsChanged"
                                 ToolTip="Separate names or unusual words with commas. Hints guide recognition and offer similar spellings. Use Replace text to correct any word or whole phrase, even when it sounds or looks completely different."
                                 AutomationProperties.Name="Names and spelling hints"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <CheckBox x:Name="selectionCheck" Content="Selected audio only" Margin="0,0,0,8"/>
                        <CheckBox x:Name="retryCheck" Content="Retry unclear passages" IsChecked="True" Margin="0,0,0,8"
                                  ToolTip="Recheck gaps and uncertain passages in the audio being transcribed. Works independently of comparison with the original song."/>
                        <CheckBox x:Name="compareCheck" Content="Compare original song" IsChecked="True"
                                  ToolTip="After isolating vocals, also transcribe the original song to look for missing words. Turn off to use only the vocals. Recovered words need a listening check."/>
                    </StackPanel>
                </Grid>
                <DockPanel Margin="0,14,0,0">
                    <Button x:Name="transcribeButton" Content="Transcribe" Style="{StaticResource Action}" Click="OnTranscribe" DockPanel.Dock="Left"/>
                    <Button x:Name="vocalsButton" Content="Vocals to new tab" Style="{StaticResource Action}" Click="OnIsolateVocals" DockPanel.Dock="Left"
                            ToolTip="Isolate the singing into a new audio tab, ready for Save As. Uses the whole file or the selected audio only; does not replace your transcript."/>
                    <Button x:Name="cancelButton" Content="Cancel" Style="{StaticResource Action}" Click="OnCancel" IsEnabled="False" DockPanel.Dock="Left"/>
                    <Button x:Name="clearButton" Content="Clear everything" Style="{StaticResource Action}" Click="OnClearEverything" DockPanel.Dock="Right" Margin="12,0,0,0"
                            ToolTip="Clear this tab's transcript, corrections, suggestions and spelling hints, reset the options, and release cached vocals. Export first to keep the words. Your audio and other tabs are kept."/>
                    <TextBlock x:Name="summaryLabel" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="8,0,0,0"
                               Text="Singing can be ambiguous. Review the result while listening."/>
                </DockPanel>
            </StackPanel>
            <Grid Grid.Row="3">
                <DataGrid x:Name="linesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionUnit="FullRow" Background="{StaticResource Panel2}"
                          BorderBrush="{StaticResource LineSoft}" BorderThickness="1" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource LineSoft}" RowHeaderWidth="0" SelectionChanged="OnLineChanged" LoadingRow="OnLyricsRowLoading"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Timed transcript; double-click text to correct it">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Binding="{Binding TimeLabel}" IsReadOnly="True" Width="122"/>
                        <DataGridTextColumn x:Name="wordsColumn" Header="WORDS · double-click to edit" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CHECK" Binding="{Binding ReviewLabel}" IsReadOnly="True" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="emptyLabel" Text="Hear the words behind the music.&#x0a;&#x0a;Choose a song or a short passage, then transcribe."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Muted}"
                           IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock x:Name="alternativeLabel" TextWrapping="Wrap" Foreground="{StaticResource Muted}" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="retryLabel" TextWrapping="Wrap" Foreground="{StaticResource Text}" MaxHeight="52"
                           Visibility="Collapsed" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                <DockPanel x:Name="spellingSuggestionPanel" Visibility="Collapsed" Margin="0,6,0,0">
                    <Button x:Name="spellingSuggestionButton" Content="Use hinted spelling" Style="{StaticResource Action}" Click="OnUseHintedSpelling" DockPanel.Dock="Right"
                            ToolTip="Apply the spelling suggestion to this line. Restore previous text can undo it. Recognition evidence and timings are kept."/>
                    <TextBlock x:Name="spellingSuggestionLabel" TextWrapping="Wrap" Foreground="{StaticResource Text}" MaxHeight="52"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="replaceTextButton" Content="Replace text…" Style="{StaticResource Action}" Click="OnReplaceText" IsEnabled="False"
                            ToolTip="Replace any word or phrase in the selected line or whole transcript. Preview changes and undo replacements."/>
                    <Button x:Name="retryButton" Content="Retry this line" Style="{StaticResource Action}" Click="OnRetryLine" IsEnabled="False"
                            ToolTip="Transcribe this line again with surrounding audio. Offers a reading without replacing your text or other lines."/>
                    <Button x:Name="acceptRetryButton" Content="Use retry reading" Style="{StaticResource Action}" Click="OnAcceptRetry" IsEnabled="False"/>
                    <Button x:Name="restoreRetryButton" Content="Restore previous text" Style="{StaticResource Action}" Click="OnRestoreRetry" IsEnabled="False"/>
                    <Button x:Name="alternativeButton" Content="Use alternate reading" Style="{StaticResource Action}" Click="OnUseAlternative" IsEnabled="False"/>
                </StackPanel>
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="playAllButton" Content="Play whole audio" Style="{StaticResource Action}" Click="OnPlayAll" DockPanel.Dock="Left"
                            ToolTip="Play the whole recording, or continue from where Stop paused it. Available before and during transcription."/>
                    <Button x:Name="restartAudioButton" Content="Restart audio" Style="{StaticResource Action}" Click="OnRestartAudio" DockPanel.Dock="Left"
                            ToolTip="Start the complete recording again from the beginning."/>
                    <Button x:Name="playButton" Content="Replay line" Style="{StaticResource Action}" Click="OnReplay" IsEnabled="False" DockPanel.Dock="Left"/>
                    <Button x:Name="stopButton" Content="Stop" Style="{StaticResource Action}" Click="OnStop" DockPanel.Dock="Left"
                            ToolTip="Pause the whole recording here; Continue audio resumes from this position. Stops line replay."/>
                    <CheckBox x:Name="loopCheck" Content="Loop" VerticalAlignment="Center" Margin="4,0,16,0" DockPanel.Dock="Left"
                              ToolTip="Repeat the whole recording or the selected line when you next start playback."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="copyButton" Content="Copy text" Style="{StaticResource Action}" Click="OnCopy" IsEnabled="False"/>
                        <Button x:Name="exportButton" Content="Export…" Style="{StaticResource Action}" Click="OnExport" IsEnabled="False"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar x:Name="progressBar" Height="3" Minimum="0" Maximum="1"/>
                    <TextBlock x:Name="statusLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"
                               Text="Edits are kept with this open tab. Export a copy before closing the audio file."/>
                </StackPanel>
                <Button x:Name="closeButton" Grid.Column="1" Content="Close" Style="{StaticResource Action}"
                        MinWidth="88" Margin="16,0,0,0" VerticalAlignment="Center" IsCancel="True" Click="OnClose"
                        AutomationProperties.Name="Close lyrics dialog"/>
            </Grid>
        </Grid>
    </Border>
</Window>
