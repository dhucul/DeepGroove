<Window x:Class="WaveLab.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="920" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" ShowInTaskbar="False"
        Closing="OnClosing" Closed="OnClosed">

    <Window.Resources>
        <Style x:Key="SettingsCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HardwareCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel2}" BorderBrush="#313841" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,15"
                    MouseLeftButtonDown="OnDragMove" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0" Padding="10">
                    <StackPanel>
                        <RadioButton x:Name="navGeneral" Content="General" IsChecked="True" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                        <RadioButton x:Name="navAudio" Content="Audio Hardware" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                        <RadioButton x:Name="navAutosave" Content="Autosave" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                        <RadioButton x:Name="navExport" Content="Export" Checked="OnNavChanged" Style="{StaticResource NavItem}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="22,18,14,18">
                    <!-- General -->
                    <StackPanel x:Name="pageGeneral" Margin="0,0,8,0">
                        <TextBlock Text="GENERAL" Style="{StaticResource SettingsCaption}" Margin="0,0,0,14"/>
                        <CheckBox x:Name="chkReopen" Content="Reopen last session files on start"/>
                        <TextBlock Text="UNDO HISTORY LIMIT" Style="{StaticResource SettingsCaption}" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Slider x:Name="sldUndo" Width="300" Minimum="64" Maximum="4096" TickFrequency="64" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Undo history memory limit"
                                    ValueChanged="OnUndoSliderChanged"/>
                            <TextBlock x:Name="lblUndo" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SettingsHint}"
                                   Text="Oldest edits are discarded once history exceeds this memory budget."/>
                    </StackPanel>

                    <!-- Audio Hardware -->
                    <ScrollViewer x:Name="pageAudio" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnRefreshHardware" Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}"
                                            Height="32" Padding="13,0" Content="↻ Refresh" Click="OnRefreshHardware"/>
                                    <Button x:Name="btnTestOutput" Style="{StaticResource AccentButton}" Height="32" Padding="13,0"
                                            Margin="8,0,0,0" Content="▶ Test Output" Click="OnTestOutput"/>
                                    <Button x:Name="btnTestInput" Style="{StaticResource AccentButton}" Height="32" Padding="13,0"
                                            Margin="8,0,0,0" Content="● Test Input" Click="OnTestInput"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="AUDIO HARDWARE" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtHardwareStatus" Margin="0,4,0,0" Style="{StaticResource SettingsHint}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource HardwareCard}">
                                <StackPanel>
                                    <TextBlock Text="ENDPOINT ROUTING" Style="{StaticResource SettingsCaption}" Margin="0,0,0,11"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="OUTPUT DEVICE" Style="{StaticResource SettingsCaption}"/>
                                            <ComboBox x:Name="cmbOutput" Margin="0,6,0,0" AutomationProperties.Name="Output device"
                                                      SelectionChanged="OnAudioConfigurationChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="DEFAULT INPUT DEVICE" Style="{StaticResource SettingsCaption}"/>
                                            <ComboBox x:Name="cmbInput" Margin="0,6,0,0" AutomationProperties.Name="Default input device"
                                                      SelectionChanged="OnAudioConfigurationChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="WINDOWS DEFAULT OUTPUT ROLE" Style="{StaticResource SettingsCaption}"/>
                                            <ComboBox x:Name="cmbOutputRole" Margin="0,6,0,0" AutomationProperties.Name="Windows default output role"
                                                      SelectionChanged="OnAudioConfigurationChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="WINDOWS DEFAULT INPUT ROLE" Style="{StaticResource SettingsCaption}"/>
                                            <ComboBox x:Name="cmbInputRole" Margin="0,6,0,0" AutomationProperties.Name="Windows default input role"
                                                      SelectionChanged="OnAudioConfigurationChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,9,0,0" Style="{StaticResource SettingsHint}"
                                               Text="The role is used only while an endpoint is set to Follow Windows default. Communications can follow a headset while Multimedia follows the main interface."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HardwareCard}">
                                <StackPanel>
                                    <TextBlock Text="WASAPI ENGINE" Style="{StaticResource SettingsCaption}" Margin="0,0,0,11"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PLAYBACK SHARING" Style="{StaticResource SettingsCaption}"/>
                                            <ComboBox x:Name="cmbOutputShare" Margin="0,6,0,0" AutomationProperties.Name="Playback sharing mode"
                                                      SelectionChanged="OnAudioConfigurationChanged"/>
                                            <TextBlock Text="PLAYBACK SCHEDULER" Style="{StaticResource SettingsCaption}" Margin="0,12,0,0"/>
                                            <ComboBox x:Name="cmbOutputScheduling" Margin="0,6,0,0" AutomationProperties.Name="Playback scheduler"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CAPTURE SHARING" Style="{StaticResource SettingsCaption}"/>
                                            <ComboBox x:Name="cmbInputShare" Margin="0,6,0,0" AutomationProperties.Name="Capture sharing mode"
                                                      SelectionChanged="OnAudioConfigurationChanged"/>
                                            <TextBlock Text="CAPTURE SCHEDULER" Style="{StaticResource SettingsCaption}" Margin="0,12,0,0"/>
                                            <ComboBox x:Name="cmbInputScheduling" Margin="0,6,0,0" AutomationProperties.Name="Capture scheduler"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="#1A1510" BorderBrush="#44311E" BorderThickness="1" CornerRadius="7"
                                            Padding="10" Margin="0,12,0,0">
                                        <TextBlock x:Name="txtModeWarning" Foreground="{StaticResource Amber}" FontSize="10.5" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HardwareCard}">
                                <StackPanel>
                                    <TextBlock Text="BUFFERING &amp; LATENCY" Style="{StaticResource SettingsCaption}" Margin="0,0,0,11"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PLAYBACK REQUEST" Style="{StaticResource SettingsCaption}"/>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="lblBuffer" DockPanel.Dock="Right" Margin="12,0,0,0"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                                <Slider x:Name="sldBuffer" Minimum="3" Maximum="500" TickFrequency="1"
                                                        AutomationProperties.Name="Playback buffer duration" ValueChanged="OnBufferSliderChanged"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CAPTURE REQUEST" Style="{StaticResource SettingsCaption}"/>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="lblCaptureBuffer" DockPanel.Dock="Right" Margin="12,0,0,0"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                                <Slider x:Name="sldCaptureBuffer" Minimum="3" Maximum="500" TickFrequency="1"
                                                        AutomationProperties.Name="Capture buffer duration" ValueChanged="OnBufferSliderChanged"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,9,0,0" Style="{StaticResource SettingsHint}"
                                               Text="These are requested stream buffers, not guaranteed round-trip latency. Driver periods and processing add latency. Very low values may fail or glitch; all audio changes apply when the next stream opens."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HardwareCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="LIVE ENDPOINT DIAGNOSTICS" Style="{StaticResource SettingsCaption}" Margin="0,0,0,11"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#101317" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="7" Padding="11">
                                            <StackPanel>
                                                <TextBlock Text="OUTPUT" Style="{StaticResource SettingsCaption}" Foreground="{StaticResource Accent}"/>
                                                <TextBlock x:Name="txtOutputDetails" Margin="0,7,0,0" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="9.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#101317" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="7" Padding="11">
                                            <StackPanel>
                                                <TextBlock Text="INPUT" Style="{StaticResource SettingsCaption}" Foreground="{StaticResource Accent}"/>
                                                <TextBlock x:Name="txtInputDetails" Margin="0,7,0,0" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="9.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Autosave -->
                    <StackPanel x:Name="pageAutosave" Visibility="Collapsed" Margin="0,0,8,0">
                        <TextBlock Text="AUTOSAVE" Style="{StaticResource SettingsCaption}" Margin="0,0,0,14"/>
                        <CheckBox x:Name="chkAutosave" Content="Autosave modified files for crash recovery"/>
                        <TextBlock Text="INTERVAL" Style="{StaticResource SettingsCaption}" Margin="0,16,0,0"/>
                        <ComboBox x:Name="cmbAutosaveInterval" Margin="0,6,0,0" Width="180" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Autosave interval"/>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource SettingsHint}"
                                   Text="Copies of unsaved work are kept in your user profile and offered for recovery if WaveLab doesn't shut down cleanly. They are removed on normal exit."/>
                    </StackPanel>

                    <!-- Export -->
                    <StackPanel x:Name="pageExport" Visibility="Collapsed" Margin="0,0,8,0">
                        <TextBlock Text="EXPORT DEFAULTS" Style="{StaticResource SettingsCaption}" Margin="0,0,0,14"/>
                        <TextBlock Text="DEFAULT FORMAT" Style="{StaticResource SettingsCaption}"/>
                        <ComboBox x:Name="cmbExportFormat" Margin="0,6,0,14" Width="360" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Default export format" SelectionChanged="OnExportFormatChanged"/>
                        <StackPanel x:Name="exportBitratePanel">
                            <TextBlock Text="DEFAULT BITRATE (LOSSY)" Style="{StaticResource SettingsCaption}"/>
                            <ComboBox x:Name="cmbExportBitrate" Margin="0,6,0,0" Width="160" HorizontalAlignment="Left"
                                      AutomationProperties.Name="Default lossy export bitrate"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="16,13">
                <DockPanel>
                    <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="34" Padding="14,0"
                            Click="OnRestoreDefaults" Content="↺ Restore Defaults" HorizontalAlignment="Left"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource AccentButton}" Foreground="{StaticResource Muted}" Height="34" Width="90"
                                Click="OnCancel" Content="Cancel" IsCancel="True"/>
                        <Button Style="{StaticResource AccentButton}" Height="34" Width="90" Margin="10,0,0,0"
                                Click="OnSave" Content="Save" IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
